---
import "~/styles/global.css";
import Header from "~/components/Header.astro";
import Footer from "~/components/Footer.astro";

export interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
  schemaType?: "WebPage" | "Service" | "Article";
}

const {
  title,
  description,
  image = "/og-default.png",
  canonical,
  noindex = false,
  schemaType = "WebPage",
} = Astro.props;

const SITE_NAME = "queNECESITAS";
const SITE_URL = import.meta.env.PUBLIC_SITE_URL ?? "https://quenecesitashoy.es";
const fullTitle = title.includes(SITE_NAME) ? title : `${title} · ${SITE_NAME}`;
const canonicalURL = canonical ?? new URL(Astro.url.pathname, SITE_URL).toString();
const ogImage = new URL(image, SITE_URL).toString();

// JSON-LD: LocalBusiness con todos los datos legales
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: "queNECESITAS",
  alternateName: "Que Necesitas Hoy",
  legalName: "Gespronet Axencia de Marketing e Deseño S.L.",
  taxID: "B75490136",
  url: SITE_URL,
  logo: `${SITE_URL}/logo.svg`,
  image: ogImage,
  description: "Comparamos alarmas, energía, telefonía e inmuebles entre las mejores compañías del mercado. Multimarca, sin compromisos ocultos. Galicia.",
  telephone: "+34672274969",
  email: "info@quenecesitashoy.es",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Rúa do Souto 1, Porto de Santa Cruz",
    addressLocality: "Oleiros",
    addressRegion: "A Coruña",
    postalCode: "15179",
    addressCountry: "ES",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: 43.3623,
    longitude: -8.3326,
  },
  openingHoursSpecification: {
    "@type": "OpeningHoursSpecification",
    dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
    opens: "08:00",
    closes: "16:00",
  },
  areaServed: {
    "@type": "State",
    name: "Galicia",
  },
  sameAs: [
    "https://www.instagram.com/quenecesitashoy",
    "https://www.facebook.com/quenecesitashoy",
  ],
};

const pageSchema = {
  "@context": "https://schema.org",
  "@type": schemaType,
  name: title,
  description: description,
  url: canonicalURL,
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={SITE_NAME} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta name="theme-color" content="#002292" />
    <meta name="format-detection" content="telephone=no" />

    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-white focus:px-4 focus:py-2 focus:rounded-md focus:shadow">
      Saltar al contenido principal
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .sr-only:focus {
    position: fixed;
    width: auto;
    height: auto;
    margin: 0;
    overflow: visible;
    clip: auto;
    white-space: normal;
  }
</style>
