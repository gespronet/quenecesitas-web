---
import BaseLayout from "@layouts/BaseLayout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import ContactForm from "@components/ContactForm.astro";
import FAQAccordion from "@components/FAQAccordion.astro";
import { serviceSchema, faqSchema } from "@lib/seo";

const capacidades = [
  {
    key: "soc",
    label: "SOC administrado",
    tag: "Monitoreo 24×7",
    desc: "Recolección y correlación de logs con SIEM. Detección de eventos, alertas priorizadas y respuesta orquestada por analistas de seguridad.",
    detail: "IBM QRadar como núcleo SIEM · Retención según servicio · Multi-tenant disponible",
  },
  {
    key: "pentest",
    label: "Pentesting",
    tag: "Validación técnica",
    desc: "Pruebas de intrusión sobre perímetro (URLs, IPs, aplicaciones expuestas). Explotación controlada para validar tu exposición real.",
    detail: "Metodología OWASP · Informes ejecutivo y técnico · Recomendaciones priorizadas",
  },
  {
    key: "va",
    label: "Vulnerability Assessment",
    tag: "Evaluación recurrente",
    desc: "Análisis periódico de vulnerabilidades sobre la superficie contratada. Priorización por criticidad y contexto real de tu negocio.",
    detail: "Escaneos regulares · CVSS + contexto · Seguimiento del ciclo de remediación",
  },
  {
    key: "purple",
    label: "Purple Team",
    tag: "Ofensivo + defensivo",
    desc: "Ejercicios coordinados donde equipos ofensivos (red) y defensivos (blue) trabajan juntos para validar detección, respuesta y capacidad real.",
    detail: "Escenarios MITRE ATT&CK · Sesiones de mejora · Métricas de detección",
  },
  {
    key: "ciso",
    label: "CISO as a Service",
    tag: "Gobierno de seguridad",
    desc: "Acompañamiento ejecutivo. Priorización de iniciativas, revisión de postura, reporting al comité, coordinación con auditorías y cumplimiento.",
    detail: "Reuniones periódicas · Roadmap de seguridad · Comité y KPIs de gobierno",
  },
];

const faqs = [
  {
    question: "¿Quién presta el servicio realmente?",
    answer:
      "El servicio Ciber 360 lo presta O4IT, empresa especializada con la que somos partners. Nosotros somos tu interlocutor local en Galicia — coordinación comercial, seguimiento y punto de contacto único. La operación técnica (SOC, ingenieros, plataforma SIEM) la ejecuta O4IT.",
  },
  {
    question: "¿Para qué tamaño de empresa está pensado?",
    answer:
      "El producto está dimensionado para empresas medianas y corporativas, aproximadamente desde 50 empleados y con superficie digital relevante (aplicaciones expuestas, servicios cloud, dispositivos gestionados, cumplimiento regulatorio). Para pymes con menos de 50 empleados estamos preparando un servicio adaptado — mientras tanto, si tienes necesidades concretas, cuéntanoslas.",
  },
  {
    question: "¿Trabajáis con empresas fuera de Galicia?",
    answer:
      "Sí. Nuestro foco natural es el noroeste peninsular (Galicia, Asturias, Castilla y León) pero por la naturaleza del servicio (SOC remoto, gestión cloud) podemos operar sobre infraestructuras de cliente en cualquier ubicación. El interlocutor local sigue siendo el mismo.",
  },
  {
    question: "¿En qué sectores tenéis experiencia?",
    answer:
      "El partner técnico (O4IT) tiene experiencia en industria, servicios financieros, salud, retail y sector público. En cada caso el enfoque se adapta a los requerimientos regulatorios específicos (ENS, RGPD, PCI-DSS, ISO 27001) y a los sistemas y aplicaciones concretos del cliente.",
  },
  {
    question: "¿Cómo empieza el proceso?",
    answer:
      "Con una primera reunión técnica — habitualmente virtual, 45-60 minutos — para entender tu contexto, tu superficie de exposición y tus preocupaciones actuales. A partir de ahí, si tiene sentido continuar, hacemos una fase de descubrimiento más detallada antes de cualquier propuesta comercial.",
  },
  {
    question: "¿La cotización tiene coste?",
    answer:
      "No. La reunión técnica inicial y la valoración preliminar son sin coste ni compromiso. Solo cuando tú confirmas que el proyecto tiene sentido pasamos a una fase de descubrimiento formal, que se acuerda por escrito antes.",
  },
];

const seo = {
  title: "Ciberseguridad empresarial en Galicia · Ciber 360 con O4IT",
  description:
    "Ciberseguridad administrada para empresas de 50+ empleados. SOC, pentesting, vulnerability assessment, purple team y CISO advisory. En partnership con O4IT.",
  additionalSchema: [
    serviceSchema(
      "Ciberseguridad empresarial · Ciber 360",
      "Ciberseguridad administrada para empresas medianas y grandes en Galicia. SOC con SIEM, pentesting, vulnerability assessment, purple team y CISO advisory. En partnership con O4IT.",
      "/ciberseguridad"
    ),
    faqSchema(faqs),
  ],
  dark: true,
};
---

<BaseLayout {...seo}>
  <Header slot="header" />

  <div class="qn-cyber-page">

    {/* HERO */}
    <section class="qn-cy-hero">
      <div class="qn-container qn-cy-hero-inner">
        <div>
          <p class="qn-eyebrow qn-cy-eyebrow">Ciberseguridad empresarial</p>
          <h1 class="qn-display-xl qn-cy-hero-title">
            Ciber 360 para empresas medianas y grandes en Galicia.
          </h1>
          <p class="qn-cy-hero-lead">
            En partnership con O4IT ofrecemos ciberseguridad administrada real — SOC, pentesting, vulnerability assessment, purple team y CISO advisory bajo un mismo servicio. Para empresas con superficie digital relevante y equipo técnico interno.
          </p>

          <div class="qn-cy-partnership">
            <div class="qn-cy-partnership-dot"></div>
            <div>
              <strong>Servicio prestado por O4IT</strong>
              <span>queNECESITAS · Partner en Galicia</span>
            </div>
          </div>

          <div class="qn-hero-ctas">
            <a href="#contacto" class="qn-btn qn-btn-accent">Reunión con equipo técnico</a>
            <a href="#pymes" class="qn-btn qn-btn-outline-white">¿Eres pyme?</a>
          </div>
        </div>

        <div class="qn-cy-hero-visual" aria-hidden="true">
          <div class="qn-cy-terminal">
            <div class="qn-cy-terminal-head">
              <span></span><span></span><span></span>
              <em>SOC · monitoring</em>
            </div>
            <div class="qn-cy-terminal-body">
              <div class="qn-cy-line"><span class="qn-cy-ok">✓</span> Perímetro estable</div>
              <div class="qn-cy-line"><span class="qn-cy-ok">✓</span> Activos SOC monitorizados</div>
              <div class="qn-cy-line"><span class="qn-cy-ok">✓</span> Pentest Q3 · sin críticos</div>
              <div class="qn-cy-line"><span class="qn-cy-warn">!</span> 2 vulnerabilidades medias</div>
              <div class="qn-cy-line"><span class="qn-cy-ok">✓</span> Purple team · programado</div>
              <div class="qn-cy-line"><span class="qn-cy-ok">✓</span> CISO briefing · próximo</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* CAPACIDADES */}
    <section class="qn-cy-caps">
      <div class="qn-container">
        <div class="qn-cy-caps-head">
          <p class="qn-eyebrow qn-cy-eyebrow">Cinco capacidades bajo un solo servicio</p>
          <h2 class="qn-display-lg qn-cy-h2">Ciber 360 no es un producto — es un modelo.</h2>
          <p class="qn-cy-caps-lead">
            El servicio integra cinco capacidades técnicas que suelen contratarse por separado. Bajo Ciber 360 se coordinan y reportan como un único servicio, con visibilidad ejecutiva y técnica.
          </p>
        </div>

        <div class="qn-cy-caps-list">
          {capacidades.map((c, i) => (
            <article class="qn-cy-cap">
              <div class="qn-cy-cap-num">
                <span>{String(i + 1).padStart(2, "0")}</span>
              </div>
              <div class="qn-cy-cap-body">
                <div class="qn-cy-cap-tag">{c.tag}</div>
                <h3 class="qn-cy-cap-title">{c.label}</h3>
                <p class="qn-cy-cap-desc">{c.desc}</p>
                <p class="qn-cy-cap-detail">{c.detail}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    {/* PROCESO */}
    <section class="qn-cy-process">
      <div class="qn-container">
        <div class="qn-cy-caps-head">
          <p class="qn-eyebrow qn-cy-eyebrow">Cómo empezamos</p>
          <h2 class="qn-display-lg qn-cy-h2">Del primer contacto al servicio activo.</h2>
        </div>

        <ol class="qn-cy-steps">
          <li>
            <div class="qn-cy-step-num">01</div>
            <h3>Reunión técnica inicial</h3>
            <p>45-60 minutos, virtual. Entendemos tu contexto, superficie de exposición y prioridades actuales.</p>
          </li>
          <li>
            <div class="qn-cy-step-num">02</div>
            <h3>Descubrimiento</h3>
            <p>Fase técnica más detallada — inventario, sistemas críticos, requerimientos regulatorios y ubicaciones.</p>
          </li>
          <li>
            <div class="qn-cy-step-num">03</div>
            <h3>Propuesta y aprobación</h3>
            <p>Diseño del servicio con capacidades, cobertura, plazos y modelo comercial. Firmado antes de arrancar.</p>
          </li>
          <li>
            <div class="qn-cy-step-num">04</div>
            <h3>Onboarding y activación</h3>
            <p>Integración de fuentes, despliegue de infraestructura SIEM, pruebas de validación y arranque operativo.</p>
          </li>
        </ol>
      </div>
    </section>

    {/* PORQUÉ CON NOSOTROS */}
    <section class="qn-cy-why">
      <div class="qn-container qn-cy-why-inner">
        <div>
          <p class="qn-eyebrow qn-cy-eyebrow">Por qué con nosotros</p>
          <h2 class="qn-display-lg qn-cy-h2">Un servicio serio, con interlocutor local.</h2>
          <p class="qn-cy-why-lead">
            La ciberseguridad seria no se contrata por catálogo online ni por comparador de precios. Se contrata con quien puede sentarse contigo, entender tu negocio y coordinar un equipo técnico real. Eso es exactamente lo que hacemos.
          </p>
          <ul class="qn-cy-why-points">
            <li>
              <span class="qn-cy-why-check">✓</span>
              <div>
                <strong>Un solo interlocutor</strong>
                <span>Contacto único desde el primer día. Ni call center, ni ticketing anónimo.</span>
              </div>
            </li>
            <li>
              <span class="qn-cy-why-check">✓</span>
              <div>
                <strong>Equipo técnico real detrás</strong>
                <span>O4IT como partner técnico, con ingenieros, analistas SOC y consultores CISO especializados.</span>
              </div>
            </li>
            <li>
              <span class="qn-cy-why-check">✓</span>
              <div>
                <strong>Sin descripciones vacías</strong>
                <span>Alcance por escrito, límites definidos, escalabilidad prevista. Sin sorpresas contractuales.</span>
              </div>
            </li>
            <li>
              <span class="qn-cy-why-check">✓</span>
              <div>
                <strong>Discreción operativa</strong>
                <span>Tu nombre no aparece en referencias públicas salvo autorización expresa por tu parte.</span>
              </div>
            </li>
          </ul>
        </div>

        <div class="qn-cy-partner-box">
          <p class="qn-eyebrow qn-cy-eyebrow">Nuestro partner técnico</p>
          <div class="qn-cy-partner-logo">O4IT</div>
          <p class="qn-cy-partner-desc">
            Empresa especializada en ciberseguridad administrada, con equipo técnico propio, SOC 24×7 y plataforma SIEM basada en IBM QRadar. Trabaja con empresas medianas y grandes en Europa y Latinoamérica.
          </p>
          <a href="https://o4it.com/" target="_blank" rel="noopener" class="qn-cy-partner-link">
            Ver o4it.com
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3" />
            </svg>
          </a>
        </div>
      </div>
    </section>

    {/* BLOQUE PYMES */}
    <section class="qn-cy-pymes" id="pymes">
      <div class="qn-container qn-cy-pymes-inner">
        <div>
          <p class="qn-eyebrow qn-cy-eyebrow">Para pymes y autónomos</p>
          <h2 class="qn-display-lg qn-cy-h2">Producto adaptado — próximamente.</h2>
          <p class="qn-cy-pymes-lead">
            Ciber 360 está pensado para empresas medianas y grandes. Sabemos que las pymes gallegas y los autónomos también sufren incidentes — phishing, ransomware, robo de credenciales — y estamos preparando un servicio adaptado a tamaño y presupuesto de ese perfil.
          </p>
          <p class="qn-cy-pymes-lead">
            Si te interesa, déjanos tu contacto. Te avisamos cuando esté disponible, sin enviar comunicaciones comerciales masivas entretanto. Si tienes una necesidad urgente concreta, cuéntanoslo también — algunos casos podemos gestionarlos ad-hoc.
          </p>
        </div>

        <div class="qn-cy-pymes-form">
          <ContactForm
            origen="ciberseguridad-pyme"
            sector="ciberseguridad-pyme"
            cta="Avísame cuando esté listo"
            variant="dark"
          />
        </div>
      </div>
    </section>

    <FAQAccordion faqs={faqs} background="paper" />

    {/* CTA FINAL — solo para empresas 50+ */}
    <section class="qn-cy-cta" id="contacto">
      <div class="qn-container qn-cy-cta-inner">
        <div>
          <p class="qn-eyebrow qn-cy-eyebrow">Reunión técnica</p>
          <h2 class="qn-display-lg qn-cy-h2">Cuéntanos tu contexto.</h2>
          <p class="qn-cy-cta-lead">
            Empresa, tamaño aproximado, sistemas críticos que te preocupan y qué te ha llevado a considerar un servicio así. Con esa base coordinamos una primera reunión técnica de 45-60 minutos, sin coste ni compromiso.
          </p>
        </div>

        <div class="qn-cy-cta-form">
          <ContactForm
            origen="ciberseguridad"
            sector="ciberseguridad"
            cta="Solicitar reunión técnica"
            variant="dark"
          />
        </div>
      </div>
    </section>

  </div>

  <Footer slot="footer" />
</BaseLayout>

<style>
  /* La página entera va sobre fondo oscuro — usamos data-theme="dark" del BaseLayout */
  .qn-cyber-page {
    background: linear-gradient(180deg, var(--qn-cyber-dark) 0%, var(--qn-cyber-950) 100%);
    color: rgba(255, 255, 255, 0.85);
  }

  .qn-cy-eyebrow {
    color: var(--qn-cyber) !important;
  }

  .qn-cy-h2 {
    color: var(--qn-white);
  }

  /* HERO */
  .qn-cy-hero {
    padding: clamp(4rem, 8vw, 7rem) 0 clamp(3rem, 5vw, 4rem);
    position: relative;
    overflow: hidden;
  }
  .qn-cy-hero::before {
    content: "";
    position: absolute;
    top: -10%;
    right: -10%;
    width: 600px; height: 600px;
    background: radial-gradient(circle, rgba(34, 211, 238, 0.12) 0%, transparent 70%);
    pointer-events: none;
  }
  .qn-cy-hero-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
    position: relative;
  }
  @media (min-width: 1000px) {
    .qn-cy-hero-inner { grid-template-columns: 1.3fr 1fr; gap: 4rem; }
  }
  .qn-cy-hero-title {
    color: var(--qn-white);
    margin: 1rem 0 1.5rem;
    max-width: 22ch;
  }
  .qn-cy-hero-lead {
    font-size: var(--qn-fs-lg);
    line-height: var(--qn-lh-relaxed);
    color: rgba(255,255,255,0.75);
    max-width: 62ch;
    margin: 0 0 1.5rem;
  }

  .qn-cy-partnership {
    display: inline-flex;
    align-items: center;
    gap: 0.875rem;
    background: rgba(34, 211, 238, 0.08);
    border: 1px solid rgba(34, 211, 238, 0.25);
    padding: 0.875rem 1.25rem;
    border-radius: var(--qn-radius-pill);
    margin: 0 0 2rem;
  }
  .qn-cy-partnership-dot {
    width: 10px; height: 10px;
    background: var(--qn-cyber);
    border-radius: 50%;
    box-shadow: 0 0 12px rgba(34,211,238,0.6);
    flex-shrink: 0;
  }
  .qn-cy-partnership strong {
    display: block;
    font-size: var(--qn-fs-sm);
    color: var(--qn-white);
    font-weight: var(--qn-fw-semibold);
  }
  .qn-cy-partnership span {
    display: block;
    font-size: var(--qn-fs-xs);
    color: rgba(255,255,255,0.6);
    margin-top: 2px;
  }

  .qn-hero-ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .qn-cy-hero .qn-btn-outline-white {
    color: var(--qn-white);
    border-color: rgba(255,255,255,0.4);
  }
  .qn-cy-hero .qn-btn-outline-white:hover {
    background: var(--qn-white);
    color: var(--qn-cyber-dark);
  }

  /* Terminal visual */
  .qn-cy-hero-visual {
    display: flex;
    justify-content: center;
  }
  .qn-cy-terminal {
    background: rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(34, 211, 238, 0.25);
    border-radius: var(--qn-radius-xl);
    overflow: hidden;
    width: 100%;
    max-width: 440px;
    box-shadow: 0 20px 60px -20px rgba(34, 211, 238, 0.3);
  }
  .qn-cy-terminal-head {
    background: rgba(255, 255, 255, 0.05);
    padding: 0.875rem 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .qn-cy-terminal-head span {
    width: 12px; height: 12px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
  }
  .qn-cy-terminal-head em {
    margin-left: auto;
    font-size: var(--qn-fs-xs);
    font-style: normal;
    color: var(--qn-cyber);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .qn-cy-terminal-body {
    padding: 1.25rem;
    font-family: var(--qn-font-mono);
    font-size: var(--qn-fs-sm);
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .qn-cy-line {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: rgba(255, 255, 255, 0.85);
  }
  .qn-cy-ok { color: #22c55e; font-weight: bold; }
  .qn-cy-warn { color: #f59e0b; font-weight: bold; }

  /* CAPS */
  .qn-cy-caps {
    padding: clamp(4rem, 8vw, 6rem) 0;
    position: relative;
  }
  .qn-cy-caps-head {
    max-width: 780px;
    margin: 0 auto 3rem;
    text-align: center;
  }
  .qn-cy-caps-head .qn-eyebrow { margin-bottom: 0.75rem; }
  .qn-cy-caps-lead {
    margin-top: 1rem;
    font-size: var(--qn-fs-md);
    color: rgba(255,255,255,0.7);
    line-height: var(--qn-lh-relaxed);
  }

  .qn-cy-caps-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 1000px;
    margin: 0 auto;
  }
  .qn-cy-cap {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--qn-radius-xl);
    padding: 2rem;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.5rem;
    transition: border-color var(--qn-transition-base), background var(--qn-transition-base);
  }
  .qn-cy-cap:hover {
    border-color: rgba(34, 211, 238, 0.3);
    background: rgba(255, 255, 255, 0.06);
  }
  @media (max-width: 640px) {
    .qn-cy-cap {
      grid-template-columns: 1fr;
      gap: 0.75rem;
      padding: 1.5rem;
    }
  }
  .qn-cy-cap-num {
    font-family: var(--qn-font-mono);
    color: var(--qn-cyber);
    font-size: var(--qn-fs-2xl);
    font-weight: var(--qn-fw-bold);
    line-height: 1;
    padding-top: 0.25rem;
    min-width: 60px;
  }
  .qn-cy-cap-tag {
    font-size: var(--qn-fs-xs);
    text-transform: uppercase;
    letter-spacing: var(--qn-tracking-wider);
    color: var(--qn-cyber);
    font-weight: var(--qn-fw-semibold);
    margin-bottom: 0.375rem;
  }
  .qn-cy-cap-title {
    font-family: var(--qn-font-sans);
    font-size: var(--qn-fs-xl);
    font-weight: var(--qn-fw-bold);
    color: var(--qn-white);
    letter-spacing: var(--qn-tracking-tight);
    line-height: var(--qn-lh-tight);
    margin: 0 0 0.625rem;
  }
  .qn-cy-cap-desc {
    color: rgba(255,255,255,0.75);
    line-height: var(--qn-lh-relaxed);
    margin: 0 0 0.75rem;
    font-size: var(--qn-fs-base);
  }
  .qn-cy-cap-detail {
    font-family: var(--qn-font-mono);
    font-size: var(--qn-fs-sm);
    color: rgba(34, 211, 238, 0.8);
    margin: 0;
    padding-top: 0.75rem;
    border-top: 1px dashed rgba(255,255,255,0.1);
    line-height: var(--qn-lh-relaxed);
  }

  /* PROCESS */
  .qn-cy-process {
    padding: clamp(4rem, 8vw, 6rem) 0;
    background: rgba(0, 0, 0, 0.2);
  }
  .qn-cy-steps {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    max-width: 1000px;
    margin: 0 auto;
  }
  @media (min-width: 640px) {
    .qn-cy-steps { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1000px) {
    .qn-cy-steps { grid-template-columns: repeat(4, 1fr); }
  }
  .qn-cy-steps li {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    padding: 1.75rem 1.5rem;
    border-radius: var(--qn-radius-xl);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .qn-cy-step-num {
    font-family: var(--qn-font-mono);
    font-size: var(--qn-fs-sm);
    color: var(--qn-cyber);
    font-weight: var(--qn-fw-bold);
    letter-spacing: var(--qn-tracking-wide);
    margin-bottom: 0.375rem;
  }
  .qn-cy-steps h3 {
    font-size: var(--qn-fs-lg);
    font-weight: var(--qn-fw-semibold);
    color: var(--qn-white);
    letter-spacing: var(--qn-tracking-tight);
