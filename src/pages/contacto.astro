---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.astro";

const seo = {
  title: "Contacto · queNECESITAS",
  description: "Llámanos, escríbenos o déjanos un mensaje. Te contestamos en menos de 24 horas laborables. A Coruña, Oleiros, Sada y Bergondo.",
};
---

<BaseLayout {...seo}>

    <section class="qn-contacto-hero">
      <div class="qn-container">
        <p class="qn-eyebrow">Contacto</p>
        <h1 class="qn-display-xl">Hablamos como prefieras.</h1>
        <p class="qn-contacto-lead">
          Lo más rápido es una llamada. Pero si prefieres un email, un mensaje desde el formulario o una visita en persona, también vale. Te respondemos en menos de 24 horas laborables.
        </p>
      </div>
    </section>

    <section class="qn-contacto-body">
      <div class="qn-container qn-contacto-grid">

        <div class="qn-contacto-info">
          <h2 class="qn-display-md">Datos de contacto</h2>

          <div class="qn-info-block">
            <span class="qn-info-label">Teléfono</span>
            <a href="tel:672274969" class="qn-info-value qn-info-link">672 274 969</a>
            <span class="qn-info-sub">Lunes a viernes, 8:00 — 16:00</span>
          </div>

          <div class="qn-info-block">
            <span class="qn-info-label">Email</span>
            <a href="mailto:info@quenecesitashoy.es" class="qn-info-value qn-info-link">info@quenecesitashoy.es</a>
            <span class="qn-info-sub">Te contestamos en menos de 24h laborables</span>
          </div>

          <div class="qn-info-block">
            <span class="qn-info-label">Oficina</span>
            <span class="qn-info-value">
              Rúa do Souto 1, Porto de Santa Cruz<br />
              15179 Oleiros · A Coruña
            </span>
            <span class="qn-info-sub">Visitas con cita previa</span>
          </div>

          <div class="qn-info-block">
            <span class="qn-info-label">Zona de trabajo</span>
            <span class="qn-info-value">
              A Coruña capital, Oleiros, Sada, Bergondo, Cambre y Culleredo
            </span>
          </div>
        </div>

        <div class="qn-contacto-form-wrap">
          <h2 class="qn-display-md">O escríbenos por aquí</h2>
          <p>Cuéntanos qué necesitas. Si es algo de inmuebles, activos de inversión o cualquier otra cosa, te lo gestionamos.</p>
          <ContactForm origen="contacto" sector="general" cta="Enviar mensaje" mostrarSector={true} />
        </div>

      </div>
    </section>

</BaseLayout>

<style>
  .qn-contacto-hero {
    padding: 5rem 0 3rem;
    background: linear-gradient(180deg, var(--color-brand-50) 0%, var(--color-bone) 100%);
  }
  .qn-contacto-hero h1 {
    margin: 0.75rem 0 1.5rem;
    max-width: 16ch;
  }
  .qn-contacto-lead {
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--color-graphite);
    max-width: 60ch;
    margin: 0;
  }

  .qn-contacto-body {
    padding: 5rem 0 6rem;
  }
  .qn-contacto-grid {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 4rem;
    align-items: start;
  }

  .qn-contacto-info {
    background: var(--color-paper);
    padding: 2.5rem;
    border-radius: 1.25rem;
    position: sticky;
    top: 6rem;
  }
  .qn-contacto-info h2 { margin: 0 0 2rem; }
  .qn-info-block {
    padding-bottom: 1.5rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-mist);
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .qn-info-block:last-child {
    border-bottom: 0;
    padding-bottom: 0;
    margin-bottom: 0;
  }
  .qn-info-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
    color: var(--color-brand-700);
  }
  .qn-info-value {
    font-family: var(--font-display);
    font-size: 1.125rem;
    color: var(--color-ink);
    font-weight: 500;
    line-height: 1.4;
  }
  .qn-info-link {
    color: var(--color-brand-700);
    text-decoration: none;
  }
  .qn-info-link:hover { text-decoration: underline; }
  .qn-info-sub {
    font-size: 0.8125rem;
    color: var(--color-graphite);
  }

  .qn-contacto-form-wrap h2 { margin: 0 0 0.75rem; }
  .qn-contacto-form-wrap > p {
    color: var(--color-graphite);
    margin: 0 0 2rem;
    line-height: 1.65;
  }

  @media (max-width: 900px) {
    .qn-contacto-grid {
      grid-template-columns: 1fr;
    }
    .qn-contacto-info {
      position: static;
    }
  }
</style>
