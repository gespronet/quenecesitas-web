---
import BaseLayout from "@layouts/BaseLayout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import ContactForm from "@components/ContactForm.astro";

const seo = {
  title: "Contacto · queNECESITAS",
  description:
    "Llámanos, escríbenos o déjanos un mensaje. Te contestamos en menos de 24 horas laborables. A Coruña, Oleiros, Sada, Bergondo y comarca.",
};

const contacto = [
  {
    icon: "phone",
    label: "Teléfono",
    value: "672 274 969",
    href: "tel:672274969",
    sub: "Lunes a viernes · 8:00 — 16:00",
  },
  {
    icon: "mail",
    label: "Email",
    value: "info@quenecesitashoy.es",
    href: "mailto:info@quenecesitashoy.es",
    sub: "Respondemos en 24h laborables",
  },
  {
    icon: "map",
    label: "Sede",
    value: "Rúa do Souto 1, Oleiros",
    href: null,
    sub: "Visitas con cita previa",
  },
];
---

<BaseLayout {...seo}>
  <Header slot="header" />

  {/* HERO */}
  <section class="qn-ct-hero">
    <div class="qn-container">
      <p class="qn-eyebrow">Contacto</p>
      <h1 class="qn-display-xl qn-ct-hero-title">
        Hablamos como prefieras.
      </h1>
      <p class="qn-ct-hero-lead">
        Lo más rápido suele ser una llamada. Si prefieres email, formulario o una visita en persona, también vale. Te respondemos en menos de 24 horas laborables.
      </p>
    </div>
  </section>

  {/* GRID CONTACTO */}
  <section class="qn-ct-body">
    <div class="qn-container qn-ct-grid">

      <aside class="qn-ct-info">

        {contacto.map((c) => (
          <div class="qn-ct-block">
            <div class="qn-ct-icon">
              {c.icon === "phone" && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                </svg>
              )}
              {c.icon === "mail" && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
              )}
              {c.icon === "map" && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
              )}
            </div>
            <div class="qn-ct-block-content">
              <span class="qn-ct-block-label">{c.label}</span>
              {c.href ? (
                <a href={c.href} class="qn-ct-block-value">{c.value}</a>
              ) : (
                <span class="qn-ct-block-value">{c.value}</span>
              )}
              <span class="qn-ct-block-sub">{c.sub}</span>
            </div>
          </div>
        ))}

        <div class="qn-ct-area">
          <span class="qn-ct-block-label">Zona natural de trabajo</span>
          <p>
            <strong>A Coruña</strong> · <strong>Oleiros</strong> · <strong>Sada</strong> · <strong>Bergondo</strong> · <strong>Cambre</strong> · <strong>Culleredo</strong>
          </p>
          <span class="qn-ct-area-sub">Fuera de esta zona estudiamos caso a caso.</span>
        </div>

      </aside>

      <div class="qn-ct-form">
        <h2 class="qn-display-md">O escríbenos por aquí.</h2>
        <p class="qn-ct-form-lead">
          Cuéntanos qué necesitas. Cualquier tema — inmobiliaria, inversión, servicios cotidianos, ciberseguridad — te lo gestionamos.
        </p>

        <ContactForm
          origen="contacto-general"
          sector="general"
          cta="Enviar mensaje"
          mostrarSector={true}
        />
      </div>

    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  /* HERO */
  .qn-ct-hero {
    padding: clamp(4rem, 8vw, 6rem) 0 clamp(2rem, 4vw, 3rem);
    background: linear-gradient(180deg, var(--qn-bone) 0%, var(--qn-white) 100%);
  }
  .qn-ct-hero-title {
    margin: 1rem 0 1.5rem;
    max-width: 15ch;
  }
  .qn-ct-hero-lead {
    font-size: var(--qn-fs-lg);
    line-height: var(--qn-lh-relaxed);
    color: var(--qn-graphite);
    max-width: 60ch;
    margin: 0;
  }

  /* BODY */
  .qn-ct-body {
    padding: clamp(3rem, 6vw, 5rem) 0 clamp(4rem, 8vw, 6rem);
  }
  .qn-ct-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: start;
  }
  @media (min-width: 900px) {
    .qn-ct-grid { grid-template-columns: 1fr 1.3fr; gap: 4rem; }
  }

  /* Info izquierda */
  .qn-ct-info {
    background: var(--qn-paper);
    padding: 2.5rem;
    border-radius: var(--qn-radius-2xl);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  @media (min-width: 900px) {
    .qn-ct-info {
      position: sticky;
      top: 6rem;
    }
  }
  .qn-ct-block {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    align-items: start;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--qn-mist);
  }
  .qn-ct-block:has(+ .qn-ct-area) {
    padding-bottom: 0;
    border-bottom: 0;
  }
  .qn-ct-block:nth-last-child(2) {
    border-bottom: 0;
    padding-bottom: 0;
  }
  .qn-ct-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px; height: 44px;
    background: var(--qn-white);
    color: var(--qn-brand-700);
    border-radius: var(--qn-radius-pill);
    flex-shrink: 0;
  }
  .qn-ct-block-content {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .qn-ct-block-label {
    font-size: var(--qn-fs-xs);
    text-transform: uppercase;
    letter-spacing: var(--qn-tracking-wider);
    color: var(--qn-brand-700);
    font-weight: var(--qn-fw-semibold);
  }
  .qn-ct-block-value {
    font-family: var(--qn-font-sans);
    font-size: var(--qn-fs-lg);
    color: var(--qn-ink);
    font-weight: var(--qn-fw-semibold);
    text-decoration: none;
    letter-spacing: var(--qn-tracking-tight);
    line-height: var(--qn-lh-tight);
  }
  a.qn-ct-block-value:hover {
    color: var(--qn-brand-700);
    text-decoration: underline;
  }
  .qn-ct-block-sub {
    font-size: var(--qn-fs-sm);
    color: var(--qn-graphite);
  }

  .qn-ct-area {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--qn-mist);
  }
  .qn-ct-area p {
    color: var(--qn-ink-soft);
    line-height: var(--qn-lh-relaxed);
    font-size: var(--qn-fs-sm);
    margin: 0;
  }
  .qn-ct-area p strong {
    color: var(--qn-brand-700);
    font-weight: var(--qn-fw-semibold);
  }
  .qn-ct-area-sub {
    font-size: var(--qn-fs-xs);
    color: var(--qn-graphite);
    font-style: italic;
  }

  /* Formulario derecha */
  .qn-ct-form h2 {
    margin: 0 0 0.75rem;
  }
  .qn-ct-form-lead {
    color: var(--qn-graphite);
    line-height: var(--qn-lh-relaxed);
    margin: 0 0 2rem;
    font-size: var(--qn-fs-md);
  }
</style>
