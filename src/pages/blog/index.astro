---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const sectorLabels = {
  alarmas: "Alarmas",
  energia: "Energía",
  telefonia: "Telefonía",
  inmuebles: "Inmuebles",
  general: "General",
};

const dateFormatter = new Intl.DateTimeFormat("es-ES", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout
  title="Blog"
  description="Guías, comparativas y consejos sobre alarmas, energía, telefonía e inmuebles en Galicia. Sin marketing, sin letra pequeña."
>
  <section class="qn-blog-hero">
    <div class="qn-container">
      <p class="qn-eyebrow">Blog</p>
      <h1 class="qn-display-xl qn-blog-title">
        Guías honestas.<br /><span>Sin marketing de por medio.</span>
      </h1>
      <p class="qn-blog-lead">
        Lo que aprendemos trabajando con clientes reales en Galicia. Comparativas, dudas frecuentes y trucos prácticos para tomar mejores decisiones.
      </p>
    </div>
  </section>

  <section class="qn-blog-list">
    <div class="qn-container">
      {posts.length === 0 ? (
        <p class="qn-blog-empty">Pronto publicaremos los primeros artículos. Vuelve en unos días.</p>
      ) : (
        <div class="qn-blog-grid">
          {posts.map((post) => (
            <article class="qn-post-card">
              <a href={`/blog/${post.id}`} class="qn-post-card-link">
                <p class="qn-post-meta">
                  <span class={`qn-post-tag qn-post-tag-${post.data.sector}`}>{sectorLabels[post.data.sector]}</span>
                  <span class="qn-post-date">{dateFormatter.format(post.data.pubDate)}</span>
                </p>
                <h2 class="qn-post-title">{post.data.title}</h2>
                <p class="qn-post-desc">{post.data.description}</p>
                <span class="qn-post-cta">
                  Leer artículo
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </span>
              </a>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .qn-blog-hero {
    padding-block: clamp(3rem, 6vw, 5rem) clamp(2rem, 4vw, 3rem);
    background: linear-gradient(180deg, var(--color-bone) 0%, white 100%);
  }

  .qn-blog-title {
    margin: 1rem 0 1.5rem;
  }

  .qn-blog-title span {
    color: var(--color-accent-500);
  }

  .qn-blog-lead {
    font-size: 1.0625rem;
    color: var(--color-graphite);
    line-height: 1.6;
    max-width: 36rem;
    margin: 0;
  }

  .qn-blog-list {
    padding-block: clamp(2rem, 4vw, 3rem) clamp(4rem, 7vw, 6rem);
  }

  .qn-blog-empty {
    text-align: center;
    color: var(--color-graphite);
    padding-block: 3rem;
    font-size: 1.0625rem;
  }

  .qn-blog-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  .qn-post-card {
    background: white;
    border: 1px solid var(--color-fog);
    border-radius: var(--radius-lg);
    transition: all 0.25s ease;
  }

  .qn-post-card:hover {
    border-color: var(--color-brand-200);
    transform: translateY(-3px);
    box-shadow: var(--shadow-elev);
  }

  .qn-post-card-link {
    display: block;
    padding: 1.75rem 1.5rem 1.5rem;
  }

  .qn-post-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 1rem;
    font-size: 0.75rem;
  }

  .qn-post-tag {
    display: inline-block;
    padding: 0.25rem 0.625rem;
    background: var(--color-brand-100);
    color: var(--color-brand-600);
    border-radius: 999px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .qn-post-tag-alarmas { background: #FFE3D6; color: #B63D17; }
  .qn-post-tag-energia { background: #FFF1C9; color: #855A0B; }
  .qn-post-tag-telefonia { background: var(--color-brand-100); color: var(--color-brand-700); }
  .qn-post-tag-inmuebles { background: #DCEFE3; color: #1F6E40; }

  .qn-post-date {
    color: var(--color-stone);
    font-size: 0.75rem;
  }

  .qn-post-title {
    font-size: 1.375rem;
    margin: 0 0 0.625rem;
    line-height: 1.2;
  }

  .qn-post-desc {
    font-size: 0.9375rem;
    color: var(--color-graphite);
    line-height: 1.6;
    margin: 0 0 1.25rem;
  }

  .qn-post-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-brand-600);
  }

  .qn-post-card:hover .qn-post-cta svg {
    transform: translateX(3px);
  }

  .qn-post-cta svg {
    transition: transform 0.2s ease;
  }

  @media (min-width: 720px) {
    .qn-blog-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .qn-blog-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
