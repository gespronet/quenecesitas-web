---
import BaseLayout from "@layouts/BaseLayout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import ProcessSteps from "@components/ProcessSteps.astro";
import ServicePoints from "@components/ServicePoints.astro";
import FAQAccordion from "@components/FAQAccordion.astro";
import ContactCTABlock from "@components/ContactCTABlock.astro";

const seo = {
  title: "queNECESITAS · Plataforma multiservicio local en Galicia",
  description:
    "Alarmas, energía, telefonía, inmobiliaria, inversión y ciberseguridad. Todo en Galicia, con criterio local, sin franquicia.",
};

const steps = [
  {
    title: "Nos cuentas qué necesitas",
    description: "Un email, una llamada o el formulario. Sin filtros comerciales.",
  },
  {
    title: "Te llamamos en 24h",
    description: "Escuchamos antes de proponer. Solo así entendemos tu caso.",
  },
  {
    title: "Analizamos con criterio",
    description: "Comparamos opciones reales, no las que nos dan más comisión.",
  },
  {
    title: "Decides con información",
    description: "Te acompañamos hasta el cierre. Y después seguimos disponibles.",
  },
];

const puntos = [
  {
    title: "Somos de aquí",
    description:
      "En Oleiros desde el primer día. Conocemos la comarca porque vivimos en ella.",
  },
  {
    title: "Sin franquicia",
    description:
      "Equipo propio. Hablas con quien lleva tu caso, no con una centralita nacional.",
  },
  {
    title: "Con criterio",
    description:
      "Formación jurídica y financiera detrás de cada recomendación. Nada de improvisar.",
  },
  {
    title: "Honestidad como norma",
    description:
      "Si no te conviene, te lo decimos. Preferimos perder un encargo a decepcionarte.",
  },
];

const faqs = [
  {
    question: "¿En qué zonas trabajáis?",
    answer:
      "A Coruña capital, Oleiros, Sada, Bergondo, Cambre y Culleredo. Fuera de esas zonas caso a caso.",
  },
  {
    question: "¿Cuánto tarda vuestra respuesta?",
    answer:
      "Menos de 24 horas laborables. Si es urgente, llama al 672 274 969 en horario 8:00-16:00.",
  },
  {
    question: "¿Cuáles son vuestros honorarios?",
    answer:
      "Depende del servicio. En todos los casos, precio cerrado por escrito antes de firmar nada. Sin sorpresas al final.",
  },
];
---

<BaseLayout {...seo}>
  <Header slot="header" />

  {/* Hero provisional Sprint 1 */}
  <section class="qn-hero-lite">
    <div class="qn-container">
      <p class="qn-eyebrow">Sprint 1 · Fundamentos técnicos</p>
      <h1 class="qn-display-xl">
        En Galicia, con criterio local.<br /><span class="qn-accent-text">Sin franquicia.</span>
      </h1>
      <p class="qn-hero-lite-lead">
        Servicios cotidianos, operaciones inmobiliarias, inversión y ciberseguridad empresarial. Todo bajo una misma casa, en A Coruña y comarca.
      </p>
      <div class="qn-hero-lite-ctas">
        <a href="/contacto" class="qn-btn qn-btn-accent">Cuéntanos qué necesitas</a>
        <a href="tel:672274969" class="qn-btn qn-btn-outline">Llamar · 672 274 969</a>
      </div>

      <div class="qn-hero-lite-stats">
        <div>
          <strong>4</strong>
          <span>Bloques de servicios</span>
        </div>
        <div>
          <strong>6</strong>
          <span>Comarcas atendidas</span>
        </div>
        <div>
          <strong>24h</strong>
          <span>Tiempo máximo de respuesta</span>
        </div>
      </div>
    </div>
  </section>

  <ProcessSteps
    title="Un proceso claro, sin sorpresas."
    steps={steps}
    background="paper"
  />

  <ServicePoints
    eyebrow="Por qué queNECESITAS"
    title="Cuatro cosas que nos definen."
    points={puntos}
    layout="grid"
    background="white"
  />

  <FAQAccordion faqs={faqs} background="bone" />

  <ContactCTABlock
    title="¿Hablamos?"
    intro="Cuéntanos qué necesitas y te llamamos en menos de 24 horas laborables."
    variant="buttons"
    background="brand"
  />

  <Footer slot="footer" />
</BaseLayout>

<style>
  .qn-hero-lite {
    padding: clamp(4rem, 8vw, 7rem) 0;
    background: linear-gradient(180deg, var(--qn-bone) 0%, var(--qn-white) 100%);
  }

  .qn-hero-lite h1 {
    max-width: 18ch;
    margin: 1rem 0 1.5rem;
  }

  .qn-accent-text {
    color: var(--qn-accent);
  }

  .qn-hero-lite-lead {
    font-size: var(--qn-fs-lg);
    line-height: var(--qn-lh-relaxed);
    color: var(--qn-graphite);
    max-width: 55ch;
    margin: 0 0 2rem;
  }

  .qn-hero-lite-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 4rem;
  }

  .qn-hero-lite-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    padding-top: 3rem;
    border-top: 1px solid var(--qn-mist);
    max-width: 640px;
  }

  .qn-hero-lite-stats > div {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .qn-hero-lite-stats strong {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: var(--qn-fw-heavy);
    color: var(--qn-brand-700);
    letter-spacing: var(--qn-tracking-tight);
    line-height: 1;
  }

  .qn-hero-lite-stats span {
    font-size: var(--qn-fs-sm);
    color: var(--qn-graphite);
    line-height: var(--qn-lh-snug);
  }

  @media (max-width: 640px) {
    .qn-hero-lite-stats {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
