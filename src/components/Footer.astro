---
const year = new Date().getFullYear();
---

<footer class="qn-footer">
  <div class="qn-container">

    <div class="qn-footer-cta">
      <div>
        <p class="qn-eyebrow">¿Hablamos?</p>
        <h2 class="qn-display-md qn-footer-cta-title">
          Cuéntanos qué necesitas y te llamamos en menos de 24h.
        </h2>
      </div>
      <div class="qn-footer-cta-actions">
        <a href="tel:672274969" class="qn-btn-accent">Llamar · 672 274 969</a>
        <a href="/contacto" class="qn-btn-outline-white">Formulario de contacto</a>
      </div>
    </div>

    <div class="qn-footer-grid">

      <div>
        <img src="/logo-white.svg" alt="queNECESITAS" width="160" height="48" class="qn-footer-logo" />
        <p class="qn-footer-tag">No nos casamos con nadie. Solo con tu beneficio.</p>
        <address class="qn-footer-addr">
          <strong>Gespronet Axencia de Marketing e Deseño, S.L.</strong><br />
          Rúa do Souto 1, Porto de Santa Cruz<br />
          15179 Oleiros · A Coruña<br />
          <a href="tel:672274969">672 274 969</a><br />
          <a href="mailto:info@quenecesitashoy.es">info@quenecesitashoy.es</a>
        </address>
      </div>

      <div>
        <h3 class="qn-footer-h">Servicios</h3>
        <ul class="qn-footer-list">
          <li><a href="/inmuebles">Inmuebles en A Coruña y comarca</a></li>
          <li><a href="/activos-inversion">Activos de inversión</a></li>
          <li><a href="/inmuebles#vender">Vende tu inmueble con nosotros</a></li>
          <li><a href="/contacto">Hablar con un asesor</a></li>
        </ul>
      </div>

      <div>
        <h3 class="qn-footer-h">Conócenos</h3>
        <ul class="qn-footer-list">
          <li><a href="/sobre-nosotros">Sobre nosotros</a></li>
          <li><a href="/blog">Blog</a></li>
          <li><a href="/contacto">Contacto</a></li>
        </ul>
      </div>

      <div>
        <h3 class="qn-footer-h">Legal</h3>
        <ul class="qn-footer-list">
          <li><a href="/aviso-legal">Aviso legal</a></li>
          <li><a href="/politica-privacidad">Política de privacidad</a></li>
          <li><a href="/politica-cookies">Política de cookies</a></li>
        </ul>
        <div class="qn-footer-social">
          <a href="https://www.linkedin.com/company/quenecesitas" aria-label="LinkedIn" target="_blank" rel="noopener noreferrer">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
          </a>
        </div>
      </div>

    </div>

    <div class="qn-footer-bottom">
      <p>© {year} Gespronet Axencia de Marketing e Deseño, S.L. · CIF B75490136 · Todos los derechos reservados.</p>
    </div>

  </div>
</footer>

<style>
  .qn-footer {
    background: var(--color-brand-900);
    color: var(--color-bone);
    padding: 5rem 0 2rem;
    margin-top: 6rem;
  }
  .qn-footer-cta {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2rem;
    align-items: end;
    padding-bottom: 3rem;
    margin-bottom: 3rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .qn-footer-cta-title {
    color: white;
    max-width: 30ch;
    margin: 0.5rem 0 0;
  }
  .qn-footer-cta-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .qn-btn-outline-white {
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: white !important;
    padding: 0.75rem 1.5rem;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9375rem;
    transition: all 0.2s;
  }
  .qn-btn-outline-white:hover {
    background: white;
    color: var(--color-brand-700) !important;
  }
  .qn-footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 3rem;
  }
  .qn-footer-logo {
    height: 2.25rem;
    width: auto;
    margin-bottom: 1.25rem;
  }
  .qn-footer-tag {
    font-style: italic;
    opacity: 0.7;
    margin: 0 0 1.5rem;
    font-size: 0.9375rem;
  }
  .qn-footer-addr {
    font-style: normal;
    line-height: 1.7;
    font-size: 0.875rem;
    opacity: 0.85;
  }
  .qn-footer-addr a {
    color: white;
    text-decoration: none;
  }
  .qn-footer-addr a:hover { text-decoration: underline; }
  .qn-footer-h {
    font-family: var(--font-display);
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: white;
    margin: 0 0 1rem;
    font-weight: 600;
  }
  .qn-footer-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .qn-footer-list a {
    color: var(--color-bone);
    opacity: 0.85;
    text-decoration: none;
    font-size: 0.9375rem;
    transition: opacity 0.2s;
  }
  .qn-footer-list a:hover { opacity: 1; }
  .qn-footer-social {
    margin-top: 1.5rem;
    display: flex;
    gap: 0.75rem;
  }
  .qn-footer-social a {
    color: white;
    opacity: 0.7;
    transition: opacity 0.2s;
  }
  .qn-footer-social a:hover { opacity: 1; }
  .qn-footer-bottom {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 0.8125rem;
    opacity: 0.6;
  }

  @media (max-width: 1024px) {
    .qn-footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }
  }
  @media (max-width: 640px) {
    .qn-footer-cta {
      grid-template-columns: 1fr;
      align-items: start;
    }
    .qn-footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
