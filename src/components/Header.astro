---
const { current } = Astro.props;
const path = Astro.url.pathname;

const isActive = (p) => path === p || path.startsWith(p + "/");
---

<header class="qn-header">
  <div class="qn-container qn-header-inner">
    <a href="/" class="qn-logo-link" aria-label="queNECESITAS — Inicio">
      <img src="/logo.svg" alt="queNECESITAS" width="180" height="48" class="qn-logo" />
    </a>

    <nav class="qn-nav" aria-label="Navegación principal">
      <ul class="qn-nav-list">
        <li><a href="/inmuebles" class={isActive("/inmuebles") ? "is-current" : ""}>Inmuebles</a></li>
        <li><a href="/activos-inversion" class={isActive("/activos-inversion") ? "is-current" : ""}>Activos de inversión</a></li>
        <li><a href="/sobre-nosotros" class={isActive("/sobre-nosotros") ? "is-current" : ""}>Sobre nosotros</a></li>
        <li><a href="/blog" class={isActive("/blog") ? "is-current" : ""}>Blog</a></li>
        <li><a href="/contacto" class="qn-nav-cta">Contacto</a></li>
      </ul>
    </nav>

    <button class="qn-burger" id="qn-burger" aria-label="Abrir menú" aria-expanded="false" aria-controls="qn-mobile-menu">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="qn-mobile-menu" id="qn-mobile-menu" hidden>
    <ul>
      <li><a href="/inmuebles">Inmuebles</a></li>
      <li><a href="/activos-inversion">Activos de inversión</a></li>
      <li><a href="/sobre-nosotros">Sobre nosotros</a></li>
      <li><a href="/blog">Blog</a></li>
      <li><a href="/contacto">Contacto</a></li>
      <li class="qn-mobile-tel"><a href="tel:672274969">Llámanos · 672 274 969</a></li>
    </ul>
  </div>
</header>

<script>
  const burger = document.querySelector(".qn-burger");
  const menu = document.getElementById("qn-mobile-menu");
  burger?.addEventListener("click", () => {
    const expanded = burger.getAttribute("aria-expanded") === "true";
    burger.setAttribute("aria-expanded", String(!expanded));
    if (menu) menu.hidden = expanded;
  });
</script>

<style>
  .qn-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: saturate(180%) blur(8px);
    border-bottom: 1px solid var(--color-mist);
  }
  .qn-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 4.5rem;
  }
  .qn-logo {
    height: 2.25rem;
    width: auto;
    display: block;
  }
  .qn-nav-list {
    display: flex;
    gap: 1.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
    align-items: center;
  }
  .qn-nav-list a {
    color: var(--color-ink);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.9375rem;
    transition: color 0.2s;
  }
  .qn-nav-list a:hover,
  .qn-nav-list a.is-current {
    color: var(--color-brand-700);
  }
  .qn-nav-cta {
    background: var(--color-brand-700);
    color: white !important;
    padding: 0.625rem 1.25rem;
    border-radius: 999px;
    font-weight: 600 !important;
  }
  .qn-nav-cta:hover {
    background: var(--color-brand-800) !important;
  }
  .qn-burger {
    display: none;
    background: none;
    border: 0;
    cursor: pointer;
    padding: 0.5rem;
    flex-direction: column;
    gap: 4px;
  }
  .qn-burger span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--color-ink);
    border-radius: 1px;
  }
  .qn-mobile-menu {
    border-top: 1px solid var(--color-mist);
    padding: 1rem;
  }
  .qn-mobile-menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .qn-mobile-menu a {
    display: block;
    padding: 0.875rem;
    color: var(--color-ink);
    text-decoration: none;
    font-weight: 500;
    border-radius: 0.5rem;
  }
  .qn-mobile-menu a:hover {
    background: var(--color-paper);
  }
  .qn-mobile-tel a {
    color: var(--color-brand-700) !important;
    font-weight: 600 !important;
  }

  @media (max-width: 768px) {
    .qn-nav { display: none; }
    .qn-burger { display: flex; }
  }
</style>
