---
const pathname = Astro.url.pathname;

const menu = [
  { label: "Servicios",     href: "/servicios" },
  { label: "Inmobiliaria",  href: "/inmobiliaria" },
  { label: "Inversión",     href: "/inversion" },
  { label: "Empresas",      href: "/ciberseguridad" },
  { label: "Nosotros",      href: "/nosotros" },
];

const isActive = (href: string) => {
  if (href === "/") return pathname === "/";
  return pathname === href || pathname.startsWith(href + "/");
};
---

<header class="qn-header">
  <div class="qn-container qn-header-inner">
    {/* Logo real — imagen desde public/logo.png */}
    <a href="/" class="qn-logo" aria-label="queNECESITAS · Inicio">
   <img
  src="/logo.svg"
  alt="queNECESITAS"
  width="220"
  height="60"
  loading="eager"
  decoding="async"
/>
    </a>

    {/* Menú desktop */}
    <nav class="qn-nav" aria-label="Principal">
      <ul class="qn-nav-list">
        {menu.map((item) => (
          <li>
            <a
              href={item.href}
              class={`qn-nav-link ${isActive(item.href) ? "is-active" : ""}`}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    {/* CTA */}
    <a href="/contacto" class="qn-btn qn-btn-primary qn-header-cta">
      Hablar con un asesor
    </a>

    {/* Toggle móvil */}
    <button
      class="qn-nav-toggle"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="qn-mobile-menu"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  {/* Menú móvil */}
  <nav class="qn-mobile-menu" id="qn-mobile-menu" aria-hidden="true">
    <ul>
      {menu.map((item) => (
        <li>
          <a
            href={item.href}
            class={isActive(item.href) ? "is-active" : ""}
          >
            {item.label}
          </a>
        </li>
      ))}
      <li>
        <a href="/contacto" class="qn-btn qn-btn-primary qn-mobile-cta">
          Hablar con un asesor
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".qn-nav-toggle");
  const menu = document.querySelector<HTMLElement>(".qn-mobile-menu");
  if (toggle && menu) {
    toggle.addEventListener("click", () => {
      const expanded = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", (!expanded).toString());
      menu.setAttribute("aria-hidden", expanded.toString());
      menu.classList.toggle("is-open");
      toggle.classList.toggle("is-open");
      document.body.style.overflow = expanded ? "" : "hidden";
    });
  }
</script>

<style>
  .qn-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--qn-fog);
    backdrop-filter: saturate(180%) blur(8px);
    background: rgba(255, 255, 255, 0.92);
  }

  .qn-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding-top: 0.875rem;
    padding-bottom: 0.875rem;
  }

  /* Logo */
  .qn-logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
    line-height: 1;
  }
  .qn-logo img {
    display: block;
    height: 44px;
    width: auto;
    max-width: 220px;
    transition: opacity var(--qn-transition-fast);
  }
  .qn-logo:hover img { opacity: 0.9; }

  @media (max-width: 600px) {
    .qn-logo img { height: 38px; }
  }

  /* Nav desktop */
  .qn-nav {
    display: none;
    flex: 1;
    justify-content: center;
  }
  @media (min-width: 900px) {
    .qn-nav { display: flex; }
  }
  .qn-nav-list {
    display: flex;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .qn-nav-link {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1rem;
    color: var(--qn-ink-soft);
    font-size: var(--qn-fs-sm);
    font-weight: var(--qn-fw-medium);
    text-decoration: none;
    border-radius: var(--qn-radius-md);
    transition: color var(--qn-transition-fast), background var(--qn-transition-fast);
  }
  .qn-nav-link:hover {
    color: var(--qn-brand-700);
    background: var(--qn-brand-50);
  }
  .qn-nav-link.is-active {
    color: var(--qn-brand-700);
    background: var(--qn-brand-50);
    font-weight: var(--qn-fw-semibold);
  }

  /* CTA en header */
  .qn-header-cta {
    display: none;
    padding: 0.625rem 1.125rem;
    font-size: var(--qn-fs-sm);
    flex-shrink: 0;
  }
  @media (min-width: 900px) {
    .qn-header-cta { display: inline-flex; }
  }

  /* Toggle móvil */
  .qn-nav-toggle {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 40px;
    height: 40px;
    padding: 8px;
    background: transparent;
    border: 0;
    cursor: pointer;
    justify-content: center;
    align-items: center;
  }
  @media (min-width: 900px) {
    .qn-nav-toggle { display: none; }
  }
  .qn-nav-toggle span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--qn-ink);
    border-radius: 2px;
    transition: transform var(--qn-transition-base), opacity var(--qn-transition-fast);
  }
  .qn-nav-toggle.is-open span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .qn-nav-toggle.is-open span:nth-child(2) { opacity: 0; }
  .qn-nav-toggle.is-open span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  /* Menú móvil */
  .qn-mobile-menu {
    display: none;
    position: fixed;
    top: 72px;
    left: 0; right: 0; bottom: 0;
    background: var(--qn-white);
    padding: 2rem;
    z-index: 40;
    overflow-y: auto;
  }
  .qn-mobile-menu.is-open { display: block; }
  .qn-mobile-menu ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .qn-mobile-menu a {
    display: block;
    padding: 1rem 1.25rem;
    color: var(--qn-ink);
    font-size: var(--qn-fs-md);
    font-weight: var(--qn-fw-medium);
    text-decoration: none;
    border-radius: var(--qn-radius-md);
    transition: background var(--qn-transition-fast);
  }
  .qn-mobile-menu a:hover,
  .qn-mobile-menu a.is-active {
    background: var(--qn-brand-50);
    color: var(--qn-brand-700);
  }
  .qn-mobile-cta {
    margin-top: 1rem;
    justify-content: center;
    width: 100%;
  }
</style>
