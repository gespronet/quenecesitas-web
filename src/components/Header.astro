---
const pathname = Astro.url.pathname;

const menu = [
  { label: "Servicios",     href: "/servicios" },
  { label: "Inmobiliaria",  href: "/inmobiliaria" },
  { label: "Inversión",     href: "/inversion" },
  { label: "Empresas",      href: "/ciberseguridad" },
  { label: "Nosotros",      href: "/nosotros" },
];

const isActive = (href: string) => {
  if (href === "/") return pathname === "/";
  return pathname === href || pathname.startsWith(href + "/");
};

const inmueblesActive = pathname.startsWith("/inmuebles");
---

<header class="qn-header">
  <div class="qn-header-track">
    <div class="qn-header-inner">
      {/* LOGO */}
      <a href="/" class="qn-logo" aria-label="queNECESITAS · Inicio">
        <img
          src="/logo.svg"
          alt="queNECESITAS"
          width="220"
          height="60"
          loading="eager"
          decoding="async"
        />
      </a>

      {/* Nav desktop */}
      <nav class="qn-nav" aria-label="Principal">
        <ul class="qn-nav-list">
          {menu.map((item, i) => (
            <li>
              <a
                href={item.href}
                class={`qn-nav-link ${isActive(item.href) ? "is-active" : ""}`}
              >
                {item.label}
              </a>
              {i < menu.length - 1 && <span class="qn-nav-sep" aria-hidden="true"></span>}
            </li>
          ))}
        </ul>
      </nav>

      {/* Zona derecha: Inmuebles + CTA */}
      <div class="qn-header-actions">
        <a
          href="/inmuebles"
          class={`qn-header-inmuebles ${inmueblesActive ? "is-active" : ""}`}
          aria-label="Ver inmuebles disponibles"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 9.5L12 3l9 6.5V21a1 1 0 0 1-1 1h-5v-7h-6v7H4a1 1 0 0 1-1-1V9.5z"></path>
          </svg>
          <span>Inmuebles</span>
        </a>

        <a href="/contacto" class="qn-btn qn-btn-primary qn-header-cta">
          Hablar con un asesor
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
            <path d="M5 12h14M13 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>

      {/* Toggle móvil */}
      <button
        class="qn-nav-toggle"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="qn-mobile-menu"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  {/* Menú móvil */}
  <nav class="qn-mobile-menu" id="qn-mobile-menu" aria-hidden="true">
    <ul>
      {menu.map((item) => (
        <li>
          <a
            href={item.href}
            class={isActive(item.href) ? "is-active" : ""}
          >
            {item.label}
          </a>
        </li>
      ))}
      <li>
        <a
          href="/inmuebles"
          class={`qn-mobile-inmuebles ${inmueblesActive ? "is-active" : ""}`}
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 9.5L12 3l9 6.5V21a1 1 0 0 1-1 1h-5v-7h-6v7H4a1 1 0 0 1-1-1V9.5z"></path>
          </svg>
          Ver inmuebles disponibles
        </a>
      </li>
      <li>
        <a href="/contacto" class="qn-btn qn-btn-primary qn-mobile-cta">
          Hablar con un asesor
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".qn-nav-toggle");
  const menu = document.querySelector<HTMLElement>(".qn-mobile-menu");
  if (toggle && menu) {
    toggle.addEventListener("click", () => {
      const expanded = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", (!expanded).toString());
      menu.setAttribute("aria-hidden", expanded.toString());
      menu.classList.toggle("is-open");
      toggle.classList.toggle("is-open");
      document.body.style.overflow = expanded ? "" : "hidden";
    });
  }
</script>

<style>
  .qn-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--qn-fog);
    box-shadow: 0 1px 0 rgba(20, 59, 158, 0.04),
                0 2px 20px -8px rgba(10, 27, 77, 0.08);
  }

  /* Pista interior con padding generoso para que respire en pantallas anchas */
  .qn-header-track {
    width: 100%;
    padding-left: clamp(1.5rem, 6vw, 8rem);
    padding-right: clamp(1.5rem, 6vw, 8rem);
  }

  .qn-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding-top: 0.875rem;
    padding-bottom: 0.875rem;
    max-width: 1400px;
    margin-left: auto;
    margin-right: auto;
  }

  /* LOGO */
  .qn-logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
    line-height: 1;
    filter: drop-shadow(0 2px 6px rgba(20, 59, 158, 0.12));
    transition: transform var(--qn-transition-fast),
                filter var(--qn-transition-fast);
  }
  .qn-logo:hover {
    transform: translateY(-1px);
    filter: drop-shadow(0 4px 10px rgba(20, 59, 158, 0.18));
  }
  .qn-logo img {
    display: block;
    height: 44px;
    width: auto;
    max-width: 220px;
  }
  @media (max-width: 600px) {
    .qn-logo img { height: 38px; }
  }

  /* NAV DESKTOP */
  .qn-nav {
    display: none;
    flex: 1;
    justify-content: center;
  }
  @media (min-width: 1024px) {
    .qn-nav { display: flex; }
  }
  .qn-nav-list {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
    align-items: center;
  }
  .qn-nav-list > li {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .qn-nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 0.625rem 1rem;
    color: var(--qn-ink-soft);
    font-size: var(--qn-fs-sm);
    font-weight: var(--qn-fw-medium);
    text-decoration: none;
    border-radius: var(--qn-radius-md);
    transition: color var(--qn-transition-fast),
                background var(--qn-transition-fast);
  }
  .qn-nav-link::after {
    content: "";
    position: absolute;
    bottom: 0.25rem;
    left: 50%;
    width: 0;
    height: 2px;
    background: var(--qn-amber-500);
    border-radius: 2px;
    transition: width var(--qn-transition-base),
                left var(--qn-transition-base);
  }
  .qn-nav-link:hover { color: var(--qn-brand-700); }
  .qn-nav-link:hover::after {
    width: 60%;
    left: 20%;
  }
  .qn-nav-link.is-active {
    color: var(--qn-brand-700);
    font-weight: var(--qn-fw-semibold);
  }
  .qn-nav-link.is-active::after {
    width: 60%;
    left: 20%;
  }

  .qn-nav-sep {
    display: inline-block;
    width: 3px;
    height: 3px;
    background: var(--qn-mist);
    border-radius: 50%;
  }

  /* ACCIONES DE LA DERECHA */
  .qn-header-actions {
    display: none;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }
  @media (min-width: 1024px) {
    .qn-header-actions { display: inline-flex; }
  }

  .qn-header-inmuebles {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1.125rem;
    background: var(--qn-brand-50);
    color: var(--qn-brand-700);
    border: 1.5px solid var(--qn-brand-100);
    border-radius: var(--qn-radius-pill);
    font-family: var(--qn-font-sans);
    font-size: var(--qn-fs-sm);
    font-weight: var(--qn-fw-semibold);
    text-decoration: none;
    transition: all var(--qn-transition-fast);
    white-space: nowrap;
  }
  .qn-header-inmuebles:hover {
    background: var(--qn-brand-700);
    color: var(--qn-white);
    border-color: var(--qn-brand-700);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px -2px rgba(20, 59, 158, 0.3);
  }
  .qn-header-inmuebles.is-active {
    background: var(--qn-brand-700);
    color: var(--qn-white);
    border-color: var(--qn-brand-700);
  }
  .qn-header-inmuebles svg { flex-shrink: 0; }

  .qn-header-cta {
    padding: 0.625rem 1.125rem;
    font-size: var(--qn-fs-sm);
    gap: 0.375rem;
  }
  .qn-header-cta svg {
    transition: transform var(--qn-transition-fast);
  }
  .qn-header-cta:hover svg {
    transform: translateX(2px);
  }

  /* TOGGLE MÓVIL */
  .qn-nav-toggle {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 44px;
    height: 44px;
    padding: 10px;
    background: transparent;
    border: 0;
    cursor: pointer;
    justify-content: center;
    align-items: center;
    border-radius: var(--qn-radius-md);
    transition: background var(--qn-transition-fast);
  }
  .qn-nav-toggle:hover { background: var(--qn-brand-50); }
  @media (min-width: 1024px) {
    .qn-nav-toggle { display: none; }
  }
  .qn-nav-toggle span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--qn-ink);
    border-radius: 2px;
    transition: transform var(--qn-transition-base),
                opacity var(--qn-transition-fast);
  }
  .qn-nav-toggle.is-open span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .qn-nav-toggle.is-open span:nth-child(2) { opacity: 0; }
  .qn-nav-toggle.is-open span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  /* MENÚ MÓVIL */
  .qn-mobile-menu {
    display: none;
    position: fixed;
    top: 72px;
    left: 0; right: 0; bottom: 0;
    background: var(--qn-white);
    padding: 1.5rem;
    z-index: 40;
    overflow-y: auto;
  }
  .qn-mobile-menu.is-open { display: block; }
  .qn-mobile-menu ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .qn-mobile-menu a {
    display: block;
    padding: 1rem 1.25rem;
    color: var(--qn-ink);
    font-size: var(--qn-fs-md);
    font-weight: var(--qn-fw-medium);
    text-decoration: none;
    border-radius: var(--qn-radius-md);
    transition: background var(--qn-transition-fast);
  }
  .qn-mobile-menu a:hover,
  .qn-mobile-menu a.is-active {
    background: var(--qn-brand-50);
    color: var(--qn-brand-700);
  }

  .qn-mobile-inmuebles {
    display: inline-flex !important;
    align-items: center;
    gap: 0.625rem;
    background: var(--qn-brand-50) !important;
    color: var(--qn-brand-700) !important;
    border: 1.5px solid var(--qn-brand-100);
    margin-top: 0.5rem;
    font-weight: var(--qn-fw-semibold) !important;
  }
  .qn-mobile-inmuebles.is-active,
  .qn-mobile-inmuebles:hover {
    background: var(--qn-brand-700) !important;
    color: var(--qn-white) !important;
    border-color: var(--qn-brand-700);
  }

  .qn-mobile-cta {
    margin-top: 1rem;
    justify-content: center;
    width: 100%;
  }
</style>
