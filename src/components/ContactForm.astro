---
interface Props {
  origen?: string;
  sector?: string;
  cta?: string;
  mostrarSector?: boolean;
  /** Variante visual: "light" para fondos claros, "dark" para fondos oscuros */
  variant?: "light" | "dark";
}

const {
  origen = "general",
  sector = "general",
  cta = "Enviar solicitud",
  mostrarSector = false,
  variant = "light",
} = Astro.props;

const webhookUrl = import.meta.env.PUBLIC_N8N_WEBHOOK_URL || "";
---

<form class="qn-form" data-variant={variant} data-origen={origen} data-sector={sector}>
  {/* Honeypot antibots */}
  <input
    type="text"
    name="website"
    tabindex="-1"
    autocomplete="off"
    class="qn-honeypot"
    aria-hidden="true"
  />

  <div class="qn-field">
    <label for={`qn-${origen}-nombre`}>Nombre y apellidos</label>
    <input
      type="text"
      id={`qn-${origen}-nombre`}
      name="nombre"
      required
      autocomplete="name"
      placeholder="¿Cómo te llamas?"
    />
  </div>

  <div class="qn-field-row">
    <div class="qn-field">
      <label for={`qn-${origen}-telefono`}>Teléfono</label>
      <input
        type="tel"
        id={`qn-${origen}-telefono`}
        name="telefono"
        required
        autocomplete="tel"
        placeholder="600 000 000"
        pattern="[0-9 +]{9,}"
      />
    </div>

    <div class="qn-field">
      <label for={`qn-${origen}-email`}>Email</label>
      <input
        type="email"
        id={`qn-${origen}-email`}
        name="email"
        required
        autocomplete="email"
        placeholder="tu@email.com"
      />
    </div>
  </div>

  {mostrarSector && (
    <div class="qn-field">
      <label for={`qn-${origen}-sector`}>¿Sobre qué nos contactas?</label>
      <select id={`qn-${origen}-sector`} name="sector">
        <option value="alarmas">Alarmas</option>
        <option value="energia">Energía</option>
        <option value="telefonia">Telefonía</option>
        <option value="inmobiliaria">Inmobiliaria</option>
        <option value="venta-directa">Venta directa (activos)</option>
        <option value="npl">NPL / Inversión</option>
        <option value="ciberseguridad">Ciberseguridad</option>
        <option value="otro">Otro tema</option>
      </select>
    </div>
  )}

  <div class="qn-field">
    <label for={`qn-${origen}-mensaje`}>Mensaje (opcional)</label>
    <textarea
      id={`qn-${origen}-mensaje`}
      name="mensaje"
      rows="4"
      placeholder="Cuéntanos brevemente qué necesitas..."
    ></textarea>
  </div>

  <label class="qn-checkbox">
    <input type="checkbox" name="rgpd" required />
    <span>
      He leído y acepto la <a href="/politica-privacidad" target="_blank" rel="noopener">política de privacidad</a>.
    </span>
  </label>

  <button type="submit" class="qn-btn qn-btn-accent qn-form-submit">
    <span class="qn-form-submit-label">{cta}</span>
    <svg class="qn-form-spinner" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
      <path d="M21 12a9 9 0 1 1-6.219-8.56" />
    </svg>
  </button>

  <p class="qn-form-status" role="status" aria-live="polite"></p>
</form>

<script define:vars={{ webhookUrl }}>
  document.querySelectorAll(".qn-form").forEach((form) => {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const honeypot = form.querySelector('input[name="website"]');
      if (honeypot && honeypot.value) return;

      const status = form.querySelector(".qn-form-status");
      const data = Object.fromEntries(new FormData(form).entries());

      if (!data.nombre || !data.email || !data.telefono || !data.rgpd) {
        if (status) status.textContent = "Completa todos los campos obligatorios.";
        form.dataset.state = "error";
        return;
      }

      form.dataset.state = "loading";

      try {
        if (!webhookUrl) throw new Error("WEBHOOK_NOT_CONFIGURED");

        const res = await fetch(webhookUrl, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            nombre: data.nombre,
            email: data.email,
            telefono: data.telefono,
            mensaje: data.mensaje || "",
            origen: form.dataset.origen,
            sector: data.sector || form.dataset.sector,
            url: window.location.href,
            website: data.website || "",
            enviado_en: new Date().toISOString(),
          }),
        });

        if (!res.ok) throw new Error(`HTTP ${res.status}`);

        if (status) status.textContent = "¡Recibido! Te contactamos en menos de 24h laborables.";
        form.dataset.state = "success";
        form.reset();
      } catch (err) {
        console.error(err);
        if (status) status.textContent = "No hemos podido enviar tu solicitud. Llámanos al 672 274 969 o escríbenos a info@quenecesitashoy.es.";
        form.dataset.state = "error";
      }
    });
  });
</script>

<style>
  .qn-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .qn-honeypot {
    position: absolute;
    left: -9999px;
    opacity: 0;
    pointer-events: none;
  }

  .qn-field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    flex: 1;
    min-width: 0;
  }

  .qn-field-row {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  @media (min-width: 600px) {
    .qn-field-row {
      flex-direction: row;
    }
  }

  .qn-field label {
    font-size: var(--qn-fs-sm);
    font-weight: var(--qn-fw-medium);
    color: var(--qn-ink-soft);
  }

  .qn-field input,
  .qn-field select,
  .qn-field textarea {
    font: inherit;
    padding: 0.875rem 1rem;
    border-radius: var(--qn-radius-md);
    border: 1px solid var(--qn-mist);
    background: var(--qn-white);
    color: var(--qn-ink);
    transition: border-color var(--qn-transition-fast), box-shadow var(--qn-transition-fast);
    width: 100%;
    min-height: 48px;
  }

  .qn-field input:focus,
  .qn-field select:focus,
  .qn-field textarea:focus {
    outline: 0;
    border-color: var(--qn-brand-700);
    box-shadow: 0 0 0 3px var(--qn-brand-100);
  }

  .qn-field textarea {
    resize: vertical;
    min-height: 100px;
  }

  .qn-checkbox {
    display: flex;
    gap: 0.625rem;
    font-size: var(--qn-fs-sm);
    color: var(--qn-ink-soft);
    line-height: var(--qn-lh-normal);
    cursor: pointer;
  }

  .qn-checkbox input {
    margin-top: 0.2rem;
    accent-color: var(--qn-brand-700);
    min-width: 18px;
    min-height: 18px;
  }

  .qn-checkbox a {
    color: var(--qn-brand-700);
    font-weight: var(--qn-fw-medium);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .qn-form-submit {
    margin-top: 0.5rem;
    position: relative;
  }

  .qn-form-spinner {
    display: none;
    animation: qn-spin 0.8s linear infinite;
  }

  .qn-form[data-state="loading"] .qn-form-submit-label {
    opacity: 0.6;
  }

  .qn-form[data-state="loading"] .qn-form-spinner {
    display: inline-block;
  }

  .qn-form[data-state="loading"] .qn-form-submit {
    pointer-events: none;
  }

  .qn-form-status {
    font-size: var(--qn-fs-sm);
    min-height: 1.25rem;
    text-align: center;
    margin: 0;
  }

  .qn-form[data-state="error"] .qn-form-status {
    color: var(--qn-alarmas);
  }

  .qn-form[data-state="success"] .qn-form-status {
    color: var(--qn-inmobiliaria);
    font-weight: var(--qn-fw-medium);
  }

  /* Variante dark */
  .qn-form[data-variant="dark"] .qn-field label,
  .qn-form[data-variant="dark"] .qn-checkbox {
    color: rgba(255, 255, 255, 0.8);
  }

  .qn-form[data-variant="dark"] .qn-field input,
  .qn-form[data-variant="dark"] .qn-field select,
  .qn-form[data-variant="dark"] .qn-field textarea {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.15);
    color: var(--qn-white);
  }

  .qn-form[data-variant="dark"] .qn-field input::placeholder,
  .qn-form[data-variant="dark"] .qn-field textarea::placeholder {
    color: rgba(255, 255, 255, 0.4);
  }

  .qn-form[data-variant="dark"] .qn-field input:focus,
  .qn-form[data-variant="dark"] .qn-field select:focus,
  .qn-form[data-variant="dark"] .qn-field textarea:focus {
    border-color: var(--qn-white);
    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.1);
  }

  .qn-form[data-variant="dark"] .qn-checkbox a {
    color: var(--qn-white);
  }
</style>
