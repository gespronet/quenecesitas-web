---
export interface Props {
  /** Identifica desde qué página/sector se envía el formulario para que n8n lo enrute */
  origen: "home" | "alarmas" | "energia" | "telefonia" | "inmuebles" | "contacto";
  /** Texto opcional sobre el formulario */
  title?: string;
  description?: string;
  /** Mostrar selector de sector (útil en formulario de contacto general) */
  showSectorSelect?: boolean;
}

const {
  origen,
  title = "Te llamamos sin compromiso",
  description = "Cuéntanos qué necesitas y te respondemos en menos de 24h laborables.",
  showSectorSelect = false,
} = Astro.props;
---

<div class="qn-form-wrap">
  {(title || description) && (
    <header class="qn-form-head">
      {title && <h3 class="qn-form-title">{title}</h3>}
      {description && <p class="qn-form-desc">{description}</p>}
    </header>
  )}

  <form class="qn-form" data-origen={origen} novalidate>
    <input type="hidden" name="origen" value={origen} />
    <input type="text" name="website" tabindex="-1" autocomplete="off" class="qn-honeypot" aria-hidden="true" />

    <div class="qn-form-row">
      <div class="qn-field">
        <label for={`qn-${origen}-nombre`}>Nombre</label>
        <input
          type="text"
          id={`qn-${origen}-nombre`}
          name="nombre"
          required
          autocomplete="name"
          placeholder="Tu nombre"
        />
      </div>

      <div class="qn-field">
        <label for={`qn-${origen}-telefono`}>Teléfono</label>
        <input
          type="tel"
          id={`qn-${origen}-telefono`}
          name="telefono"
          required
          autocomplete="tel"
          placeholder="600 000 000"
          pattern="[0-9 +]{9,15}"
        />
      </div>
    </div>

    <div class="qn-field">
      <label for={`qn-${origen}-email`}>Email</label>
      <input
        type="email"
        id={`qn-${origen}-email`}
        name="email"
        required
        autocomplete="email"
        placeholder="tu@email.com"
      />
    </div>

    {showSectorSelect && (
      <div class="qn-field">
        <label for={`qn-${origen}-sector`}>Sector de interés</label>
        <select id={`qn-${origen}-sector`} name="sector" required>
          <option value="">Selecciona uno</option>
          <option value="alarmas">Alarmas</option>
          <option value="energia">Energía</option>
          <option value="telefonia">Telefonía</option>
          <option value="inmuebles">Inmuebles</option>
          <option value="otro">Otro / no lo tengo claro</option>
        </select>
      </div>
    )}

    <div class="qn-field">
      <label for={`qn-${origen}-mensaje`}>¿Qué necesitas?</label>
      <textarea
        id={`qn-${origen}-mensaje`}
        name="mensaje"
        rows="4"
        placeholder="Cuéntanos brevemente qué buscas..."
      ></textarea>
    </div>

    <label class="qn-checkbox">
      <input type="checkbox" name="rgpd" required />
      <span>
        He leído y acepto la <a href="/politica-privacidad">política de privacidad</a>.
      </span>
    </label>

    <button type="submit" class="qn-btn-accent qn-form-submit">
      <span class="qn-form-submit-label">Enviar solicitud</span>
      <svg class="qn-form-spinner" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
        <path d="M21 12a9 9 0 1 1-6.219-8.56"/>
      </svg>
    </button>

    <p class="qn-form-status" role="status" aria-live="polite"></p>
  </form>
</div>

<style>
  .qn-form-wrap {
    background: var(--color-paper);
    border: 1px solid var(--color-fog);
    border-radius: var(--radius-xl);
    padding: 1.75rem;
    box-shadow: var(--shadow-soft);
  }

  @media (min-width: 640px) {
    .qn-form-wrap { padding: 2.25rem; }
  }

  .qn-form-head {
    margin-bottom: 1.5rem;
  }

  .qn-form-title {
    font-size: 1.5rem;
    margin: 0 0 0.5rem;
  }

  .qn-form-desc {
    font-size: 0.9375rem;
    color: var(--color-graphite);
    margin: 0;
    line-height: 1.5;
  }

  .qn-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .qn-form-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 540px) {
    .qn-form-row { grid-template-columns: 1fr 1fr; }
  }

  .qn-field { display: flex; flex-direction: column; gap: 0.4375rem; }

  .qn-field label {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-ink-soft);
  }

  .qn-field input,
  .qn-field select,
  .qn-field textarea {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    padding: 0.75rem 0.875rem;
    border: 1px solid var(--color-fog);
    border-radius: var(--radius-md);
    background: white;
    color: var(--color-ink-soft);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
    width: 100%;
  }

  .qn-field input:focus,
  .qn-field select:focus,
  .qn-field textarea:focus {
    outline: none;
    border-color: var(--color-brand-500);
    box-shadow: 0 0 0 3px rgba(30, 63, 184, 0.12);
  }

  .qn-field textarea {
    resize: vertical;
    min-height: 96px;
  }

  .qn-honeypot {
    position: absolute !important;
    left: -9999px !important;
    width: 1px !important;
    height: 1px !important;
    opacity: 0 !important;
    pointer-events: none;
  }

  .qn-checkbox {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    font-size: 0.8125rem;
    color: var(--color-graphite);
    line-height: 1.5;
  }

  .qn-checkbox input { margin-top: 0.1875rem; flex-shrink: 0; }

  .qn-checkbox a {
    color: var(--color-brand-600);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  .qn-form-submit {
    margin-top: 0.5rem;
    justify-content: center;
    cursor: pointer;
    border: none;
  }

  .qn-form-spinner {
    display: none;
    animation: qn-spin 0.7s linear infinite;
  }

  @keyframes qn-spin {
    to { transform: rotate(360deg); }
  }

  .qn-form[data-state="loading"] .qn-form-spinner { display: inline-block; }
  .qn-form[data-state="loading"] .qn-form-submit-label { opacity: 0.7; }
  .qn-form[data-state="loading"] .qn-form-submit { pointer-events: none; opacity: 0.85; }

  .qn-form-status {
    font-size: 0.875rem;
    margin: 0;
    padding: 0.75rem 0.875rem;
    border-radius: var(--radius-md);
    display: none;
  }

  .qn-form[data-state="success"] .qn-form-status {
    display: block;
    background: #E7F6EE;
    color: #0F5C2C;
    border: 1px solid #B6E0C6;
  }

  .qn-form[data-state="error"] .qn-form-status {
    display: block;
    background: #FCEBEB;
    color: #7A1F1F;
    border: 1px solid #F0BABA;
  }
</style>

<script>
  const WEBHOOK = import.meta.env.PUBLIC_N8N_WEBHOOK_URL;

  document.querySelectorAll<HTMLFormElement>(".qn-form").forEach((form) => {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      // Honeypot anti-bots
      const hp = form.querySelector<HTMLInputElement>('input[name="website"]');
      if (hp && hp.value) return;

      const status = form.querySelector<HTMLElement>(".qn-form-status");
      const data = Object.fromEntries(new FormData(form).entries());

      // Validación básica
      if (!data.nombre || !data.email || !data.telefono || !data.rgpd) {
        if (status) status.textContent = "Completa todos los campos obligatorios.";
        form.dataset.state = "error";
        return;
      }

      form.dataset.state = "loading";

      try {
        if (!WEBHOOK) throw new Error("WEBHOOK_NOT_CONFIGURED");

        const payload = {
          ...data,
          origen: form.dataset.origen,
          enviado_en: new Date().toISOString(),
          url: window.location.href,
          referrer: document.referrer || null,
        };

        const res = await fetch(WEBHOOK, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });

        if (!res.ok) throw new Error("HTTP_" + res.status);

        if (status) status.textContent = "¡Recibido! Te contactamos en menos de 24h laborables.";
        form.dataset.state = "success";
        form.reset();
      } catch (err) {
        console.error(err);
        if (status) {
          status.textContent = "No hemos podido enviar tu solicitud. Llámanos al 672 274 969 o escríbenos a info@quenecesitashoy.es.";
        }
        form.dataset.state = "error";
      }
    });
  });
</script>
