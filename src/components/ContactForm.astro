---
const {
  origen = "general",
  sector = "general",
  cta = "Enviar solicitud",
  mostrarSector = false,
} = Astro.props;

const webhookUrl = import.meta.env.PUBLIC_N8N_WEBHOOK_URL || "";
const siteUrl = import.meta.env.PUBLIC_SITE_URL || "https://quenecesitashoy.es";
---

<form class="qn-form" data-origen={origen} data-sector={sector}>
  {/* Honeypot anti-bots — campo invisible */}
  <input type="text" name="website" tabindex="-1" autocomplete="off" class="qn-honeypot" aria-hidden="true" />

  <div class="qn-field">
    <label for={`qn-${origen}-nombre`}>Nombre y apellidos</label>
    <input type="text" id={`qn-${origen}-nombre`} name="nombre" required autocomplete="name" placeholder="¿Cómo te llamas?" />
  </div>

  <div class="qn-field">
    <label for={`qn-${origen}-telefono`}>Teléfono</label>
    <input type="tel" id={`qn-${origen}-telefono`} name="telefono" required autocomplete="tel" placeholder="600 000 000" pattern="[0-9 +]{9,}" />
  </div>

  <div class="qn-field">
    <label for={`qn-${origen}-email`}>Email</label>
    <input type="email" id={`qn-${origen}-email`} name="email" required autocomplete="email" placeholder="tu@email.com" />
  </div>

  {mostrarSector && (
    <div class="qn-field">
      <label for={`qn-${origen}-sector`}>¿Sobre qué nos contactas?</label>
      <select id={`qn-${origen}-sector`} name="sector">
        <option value="inmuebles">Inmuebles (vender o comprar)</option>
        <option value="activos">Activos de inversión</option>
        <option value="otro">Otro tema</option>
      </select>
    </div>
  )}

  <div class="qn-field">
    <label for={`qn-${origen}-mensaje`}>Mensaje (opcional)</label>
    <textarea id={`qn-${origen}-mensaje`} name="mensaje" rows="4" placeholder="Cuéntanos brevemente qué necesitas..."></textarea>
  </div>

  <label class="qn-checkbox">
    <input type="checkbox" name="rgpd" required />
    <span>
      He leído y acepto la <a href="/politica-privacidad" target="_blank" rel="noopener">política de privacidad</a>.
    </span>
  </label>

  <button type="submit" class="qn-btn-accent qn-form-submit">
    <span class="qn-form-submit-label">{cta}</span>
    <svg class="qn-form-spinner" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
      <path d="M21 12a9 9 0 1 1-6.219-8.56" />
    </svg>
  </button>

  <p class="qn-form-status" role="status" aria-live="polite"></p>
</form>

<script define:vars={{ webhookUrl, siteUrl }}>
  document.querySelectorAll(".qn-form").forEach((form) => {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      // Honeypot: si está relleno, es un bot
      const honeypot = form.querySelector('input[name="website"]');
      if (honeypot && honeypot.value) return;

      const status = form.querySelector(".qn-form-status");
      const data = Object.fromEntries(new FormData(form).entries());

      if (!data.nombre || !data.email || !data.telefono || !data.rgpd) {
        if (status) status.textContent = "Completa todos los campos obligatorios.";
        form.dataset.state = "error";
        return;
      }

      form.dataset.state = "loading";

      try {
        if (!webhookUrl) throw new Error("WEBHOOK_NOT_CONFIGURED");

        const res = await fetch(webhookUrl, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            nombre: data.nombre,
            email: data.email,
            telefono: data.telefono,
            mensaje: data.mensaje || "",
            origen: form.dataset.origen,
            sector: data.sector || form.dataset.sector,
            url: window.location.href,
            website: data.website || "",
            enviado_en: new Date().toISOString(),
          }),
        });

        if (!res.ok) throw new Error(`HTTP ${res.status}`);

        if (status) status.textContent = "¡Recibido! Te contactamos en menos de 24h laborables.";
        form.dataset.state = "success";
        form.reset();
      } catch (err) {
        console.error(err);
        if (status) status.textContent = "No hemos podido enviar tu solicitud. Llámanos al 672 274 969 o escríbenos a info@quenecesitashoy.es.";
        form.dataset.state = "error";
      }
    });
  });
</script>

<style>
  .qn-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .qn-honeypot {
    position: absolute;
    left: -9999px;
    opacity: 0;
    pointer-events: none;
  }
  .qn-field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .qn-field label {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-ink-soft);
  }
  .qn-field input,
  .qn-field select,
  .qn-field textarea {
    font: inherit;
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    border: 1px solid var(--color-mist);
    background: white;
    color: var(--color-ink);
    transition: border-color 0.15s;
  }
  .qn-field input:focus,
  .qn-field select:focus,
  .qn-field textarea:focus {
    outline: 0;
    border-color: var(--color-brand-700);
    box-shadow: 0 0 0 3px var(--color-brand-100);
  }
  .qn-field textarea {
    resize: vertical;
    min-height: 90px;
  }
  .qn-checkbox {
    display: flex;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--color-ink-soft);
    line-height: 1.5;
  }
  .qn-checkbox input {
    margin-top: 0.2rem;
    accent-color: var(--color-brand-700);
  }
  .qn-checkbox a {
    color: var(--color-brand-700);
    font-weight: 500;
  }
  .qn-form-submit {
    margin-top: 0.5rem;
    justify-content: center;
    position: relative;
  }
  .qn-form-spinner {
    display: none;
    animation: qn-spin 0.8s linear infinite;
  }
  .qn-form[data-state="loading"] .qn-form-submit-label {
    opacity: 0.6;
  }
  .qn-form[data-state="loading"] .qn-form-spinner {
    display: inline-block;
  }
  .qn-form[data-state="loading"] .qn-form-submit {
    pointer-events: none;
  }
  .qn-form-status {
    font-size: 0.875rem;
    min-height: 1.25rem;
    margin: 0;
    text-align: center;
  }
  .qn-form[data-state="error"] .qn-form-status {
    color: #B63D17;
  }
  .qn-form[data-state="success"] .qn-form-status {
    color: #1F6E40;
    font-weight: 500;
  }
  @keyframes qn-spin {
    to { transform: rotate(360deg); }
  }
</style>
