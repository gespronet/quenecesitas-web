---
const services = [
  {
    title: "Alarmas",
    href: "/alarmas",
    description: "Comparamos las marcas líderes en seguridad. Tú decides según precio, servicio y conexión a CRA.",
    icon: "shield",
  },
  {
    title: "Energía",
    href: "/energia",
    description: "Luz y gas. Buscamos la tarifa más baja del mercado y nos encargamos del cambio sin papeleo.",
    icon: "bolt",
  },
  {
    title: "Telefonía",
    href: "/telefonia",
    description: "Fibra, móvil y centralitas virtuales. Para hogar y empresa, con la mejor combinación de precio y red.",
    icon: "signal",
  },
  {
    title: "Inmuebles",
    href: "/inmuebles",
    description: "Compraventa y alquiler en A Coruña, Oleiros, Sada y Bergondo. Asesoramiento personal y honesto.",
    icon: "home",
  },
];
---

<section class="qn-services" aria-labelledby="services-heading">
  <div class="qn-container">
    <div class="qn-services-head">
      <p class="qn-eyebrow">Lo que hacemos</p>
      <h2 id="services-heading" class="qn-display-lg qn-services-title">
        Cuatro sectores.<br /><span>Una misma promesa.</span>
      </h2>
      <p class="qn-services-lead">
        Comparamos, te explicamos y gestionamos el cambio por ti. Sin filtros comerciales, sin compromisos ocultos.
      </p>
    </div>

    <div class="qn-services-grid">
      {services.map((service) => (
        <a href={service.href} class="qn-service-card">
          <div class="qn-service-icon">
            {service.icon === "shield" && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2 L4 6 v6 c0 5 3.5 9 8 10 c4.5-1 8-5 8-10 V6 z"/></svg>
            )}
            {service.icon === "bolt" && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2 L3 14 h7 l-1 8 L19 10 h-7 z"/></svg>
            )}
            {service.icon === "signal" && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 16 c2-4 4-6 8-6 s6 2 8 6"/><path d="M5 12 c2-3 4-4 7-4 s5 1 7 4"/><circle cx="12" cy="18.5" r="1.5" fill="currentColor"/></svg>
            )}
            {service.icon === "home" && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11 L12 3 L21 11 V21 H3 z"/><path d="M9 21 V14 H15 V21"/></svg>
            )}
          </div>
          <h3 class="qn-service-title">{service.title}</h3>
          <p class="qn-service-desc">{service.description}</p>
          <span class="qn-service-link">
            Ver detalle
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .qn-services {
    padding-block: clamp(4rem, 7vw, 6rem);
  }

  .qn-services-head {
    max-width: 640px;
    margin-bottom: 3rem;
  }

  .qn-services-title {
    margin: 1rem 0 1.25rem;
  }

  .qn-services-title span {
    color: var(--color-accent-500);
  }

  .qn-services-lead {
    font-size: 1.0625rem;
    color: var(--color-graphite);
    line-height: 1.6;
    margin: 0;
  }

  .qn-services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .qn-service-card {
    display: flex;
    flex-direction: column;
    background: var(--color-paper);
    border: 1px solid var(--color-fog);
    border-radius: var(--radius-lg);
    padding: 1.75rem 1.5rem 1.5rem;
    transition: all 0.25s ease;
  }

  .qn-service-card:hover {
    border-color: var(--color-brand-200);
    transform: translateY(-3px);
    box-shadow: var(--shadow-elev);
  }

  .qn-service-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background: var(--color-brand-100);
    color: var(--color-brand-600);
    margin-bottom: 1.25rem;
    transition: all 0.25s ease;
  }

  .qn-service-card:hover .qn-service-icon {
    background: var(--color-brand-600);
    color: white;
  }

  .qn-service-title {
    font-size: 1.375rem;
    margin: 0 0 0.5rem;
  }

  .qn-service-desc {
    font-size: 0.9375rem;
    color: var(--color-graphite);
    line-height: 1.55;
    margin: 0 0 1.5rem;
    flex: 1;
  }

  .qn-service-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-brand-600);
    letter-spacing: 0.02em;
  }

  .qn-service-link svg {
    transition: transform 0.2s ease;
  }

  .qn-service-card:hover .qn-service-link svg {
    transform: translateX(3px);
  }

  @media (min-width: 640px) {
    .qn-services-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }
  }

  @media (min-width: 1024px) {
    .qn-services-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
