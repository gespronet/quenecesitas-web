---
interface FAQ {
  question: string;
  answer: string;
}

interface Props {
  eyebrow?: string;
  title?: string;
  faqs: FAQ[];
  background?: "white" | "paper" | "bone";
}

const {
  eyebrow = "Dudas frecuentes",
  title = "Lo que más nos preguntan.",
  faqs,
  background = "bone",
} = Astro.props;
---

<section class:list={["qn-faq", `qn-faq-bg-${background}`]}>
  <div class="qn-container qn-container-narrow">
    <div class="qn-faq-head">
      <p class="qn-eyebrow">{eyebrow}</p>
      <h2 class="qn-display-lg">{title}</h2>
    </div>

    <div class="qn-faq-list">
      {faqs.map((faq) => (
        <details class="qn-faq-item">
          <summary>
            <span>{faq.question}</span>
            <span class="qn-faq-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                <path d="M6 9l6 6 6-6" />
              </svg>
            </span>
          </summary>
          <div class="qn-faq-answer">
            <p>{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .qn-faq {
    padding: clamp(4rem, 8vw, 6rem) 0;
  }

  .qn-faq-bg-white { background: var(--qn-white); }
  .qn-faq-bg-paper { background: var(--qn-paper); }
  .qn-faq-bg-bone { background: var(--qn-bone); }

  .qn-faq-head {
    max-width: 620px;
    margin: 0 auto 3rem;
    text-align: center;
  }

  .qn-faq-head .qn-eyebrow {
    margin-bottom: 0.75rem;
  }

  .qn-faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .qn-faq-item {
    background: var(--qn-white);
    border-radius: var(--qn-radius-lg);
    border: 1px solid var(--qn-mist);
    overflow: hidden;
    transition: box-shadow var(--qn-transition-base);
  }

  .qn-faq-item:hover {
    box-shadow: var(--qn-shadow-sm);
  }

  .qn-faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.375rem 1.75rem;
    font-size: var(--qn-fs-md);
    font-weight: var(--qn-fw-semibold);
    color: var(--qn-ink);
    cursor: pointer;
    list-style: none;
    min-height: 48px;
  }

  .qn-faq-item summary::-webkit-details-marker {
    display: none;
  }

  .qn-faq-item summary:hover {
    color: var(--qn-brand-700);
  }

  .qn-faq-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    color: var(--qn-accent);
    border-radius: var(--qn-radius-pill);
    transition: transform var(--qn-transition-base);
    flex-shrink: 0;
  }

  .qn-faq-item[open] .qn-faq-icon {
    transform: rotate(180deg);
  }

  .qn-faq-answer {
    padding: 0 1.75rem 1.5rem;
  }

  .qn-faq-answer p {
    color: var(--qn-graphite);
    line-height: var(--qn-lh-relaxed);
    font-size: var(--qn-fs-base);
  }
</style>
