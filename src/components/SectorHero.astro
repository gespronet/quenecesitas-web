---
export interface Props {
  category: string;
  title: string;
  highlight?: string;
  description: string;
  benefits: string[];
}

const { category, title, highlight, description, benefits } = Astro.props;
---

<section class="qn-sector-hero">
  <div class="qn-container qn-sector-hero-inner">
    <div>
      <p class="qn-eyebrow">{category}</p>
      <h1 class="qn-display-xl qn-sector-hero-title qn-reveal">
        {title}
        {highlight && <><br /><span class="qn-sector-hero-highlight">{highlight}</span></>}
      </h1>
      <p class="qn-sector-hero-lead qn-reveal qn-reveal-delay-1">{description}</p>
    </div>

    <ul class="qn-sector-benefits qn-reveal qn-reveal-delay-2">
      {benefits.map((benefit) => (
        <li>
          <span class="qn-bullet" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </span>
          {benefit}
        </li>
      ))}
    </ul>
  </div>

  <svg class="qn-sector-hero-deco" viewBox="0 0 600 400" aria-hidden="true">
    <defs>
      <pattern id="qn-sector-grid" x="0" y="0" width="32" height="32" patternUnits="userSpaceOnUse">
        <path d="M32 0 H0 V32" stroke="currentColor" fill="none" stroke-width="0.5" />
      </pattern>
    </defs>
    <rect width="600" height="400" fill="url(#qn-sector-grid)" />
  </svg>
</section>

<style>
  .qn-sector-hero {
    position: relative;
    padding-block: clamp(3.5rem, 6vw, 5.5rem);
    background:
      linear-gradient(180deg, var(--color-bone) 0%, white 100%);
    overflow: hidden;
  }

  .qn-sector-hero-deco {
    position: absolute;
    bottom: -20%;
    right: -10%;
    width: 50%;
    max-width: 500px;
    color: rgba(0, 34, 146, 0.06);
    pointer-events: none;
  }

  .qn-sector-hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  .qn-sector-hero-title {
    margin: 1rem 0 1.25rem;
    font-size: clamp(2rem, 5vw, 3.75rem) !important;
  }

  .qn-sector-hero-highlight {
    color: var(--color-accent-500);
  }

  .qn-sector-hero-lead {
    font-size: 1.0625rem;
    color: var(--color-graphite);
    line-height: 1.6;
    max-width: 32rem;
    margin: 0;
  }

  .qn-sector-benefits {
    list-style: none;
    padding: 1.75rem;
    margin: 0;
    background: white;
    border: 1px solid var(--color-fog);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-soft);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .qn-sector-benefits li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.9375rem;
    color: var(--color-ink-soft);
    line-height: 1.5;
  }

  .qn-bullet {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--color-accent-500);
    color: white;
    margin-top: 1px;
  }

  @media (min-width: 900px) {
    .qn-sector-hero-inner {
      grid-template-columns: 1.3fr 1fr;
      gap: 4rem;
    }
  }
</style>
