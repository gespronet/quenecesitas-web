---
interface Step {
  title: string;
  description: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  steps: Step[];
  background?: "white" | "paper" | "brand";
}

const {
  eyebrow = "Cómo trabajamos",
  title,
  steps,
  background = "white",
} = Astro.props;
---

<section class:list={["qn-process", `qn-process-bg-${background}`]}>
  <div class="qn-container">
    <div class="qn-process-head">
      <p class="qn-eyebrow">{eyebrow}</p>
      <h2 class="qn-display-lg">{title}</h2>
    </div>

    <ol class="qn-process-steps" role="list">
      {steps.map((step, i) => (
        <li class="qn-process-step">
          <div class="qn-process-num">
            <span>{String(i + 1).padStart(2, "0")}</span>
          </div>
          <h3 class="qn-process-title">{step.title}</h3>
          <p class="qn-process-desc">{step.description}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .qn-process {
    padding: clamp(4rem, 8vw, 6rem) 0;
  }

  .qn-process-bg-white {
    background: var(--qn-white);
  }

  .qn-process-bg-paper {
    background: var(--qn-paper);
  }

  .qn-process-bg-brand {
    background: var(--qn-brand-900);
    color: var(--qn-bone);
  }

  .qn-process-bg-brand h2,
  .qn-process-bg-brand h3 {
    color: var(--qn-white);
  }

  .qn-process-bg-brand .qn-process-desc {
    color: rgba(255, 255, 255, 0.75);
  }

  .qn-process-bg-brand .qn-process-step {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.1);
  }

  .qn-process-head {
    max-width: 720px;
    margin: 0 auto 3rem;
    text-align: center;
  }

  .qn-process-head .qn-eyebrow {
    margin-bottom: 0.75rem;
  }

  .qn-process-steps {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .qn-process-steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .qn-process-steps {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .qn-process-step {
    background: var(--qn-white);
    border: 1px solid var(--qn-mist);
    padding: 2rem 1.75rem;
    border-radius: var(--qn-radius-xl);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: transform var(--qn-transition-base), box-shadow var(--qn-transition-base);
  }

  .qn-process-step:hover {
    transform: translateY(-4px);
    box-shadow: var(--qn-shadow-lg);
  }

  .qn-process-bg-paper .qn-process-step {
    background: var(--qn-white);
  }

  .qn-process-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--qn-radius-pill);
    background: var(--qn-accent-soft);
    color: var(--qn-accent);
    font-weight: var(--qn-fw-bold);
    font-size: var(--qn-fs-md);
    letter-spacing: var(--qn-tracking-tight);
    margin-bottom: 0.5rem;
  }

  .qn-process-title {
    font-size: var(--qn-fs-xl);
    font-weight: var(--qn-fw-semibold);
    line-height: var(--qn-lh-tight);
    letter-spacing: var(--qn-tracking-tight);
  }

  .qn-process-desc {
    color: var(--qn-graphite);
    font-size: var(--qn-fs-base);
    line-height: var(--qn-lh-relaxed);
    margin: 0;
  }
</style>
