---
const steps = [
  {
    number: "01",
    title: "Cuéntanos qué necesitas",
    description: "Una llamada o un formulario. En 5 minutos entendemos qué buscas y qué prioridades tienes — precio, servicio, plazos.",
  },
  {
    number: "02",
    title: "Comparamos por ti",
    description: "Analizamos las mejores compañías del mercado. Te presentamos opciones reales con números claros, sin letra pequeña.",
  },
  {
    number: "03",
    title: "Tú eliges, nosotros gestionamos",
    description: "Te quedas con la opción que más te conviene. Nosotros nos ocupamos del cambio, los trámites y el papeleo.",
  },
];
---

<section class="qn-process" id="proceso" aria-labelledby="process-heading">
  <div class="qn-container">
    <div class="qn-process-head">
      <p class="qn-eyebrow">Cómo trabajamos</p>
      <h2 id="process-heading" class="qn-display-lg qn-process-title">
        Tres pasos. Cero complicaciones.
      </h2>
    </div>

    <div class="qn-process-grid">
      {steps.map((step, i) => (
        <div class="qn-step">
          <div class="qn-step-number">{step.number}</div>
          <h3 class="qn-step-title">{step.title}</h3>
          <p class="qn-step-desc">{step.description}</p>
          {i < steps.length - 1 && (
            <div class="qn-step-connector" aria-hidden="true">
              <svg width="32" height="12" viewBox="0 0 32 12" fill="none">
                <path d="M0 6 H28 M22 1 L28 6 L22 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .qn-process {
    padding-block: clamp(4rem, 7vw, 6rem);
    background: var(--color-bone);
  }

  .qn-process-head {
    max-width: 600px;
    margin-bottom: 3.5rem;
  }

  .qn-process-title {
    margin: 1rem 0 0;
  }

  .qn-process-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    position: relative;
  }

  .qn-step {
    position: relative;
  }

  .qn-step-number {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 3rem;
    color: var(--color-brand-200);
    line-height: 1;
    letter-spacing: -0.04em;
    margin-bottom: 1rem;
  }

  .qn-step-title {
    font-size: 1.375rem;
    margin: 0 0 0.625rem;
  }

  .qn-step-desc {
    font-size: 0.9375rem;
    color: var(--color-graphite);
    line-height: 1.6;
    margin: 0;
    max-width: 28rem;
  }

  .qn-step-connector {
    display: none;
    position: absolute;
    top: 1.25rem;
    right: -1.5rem;
    color: var(--color-brand-300);
  }

  @media (min-width: 768px) {
    .qn-process-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 3rem;
    }
    .qn-step-connector {
      display: block;
    }
  }
</style>
