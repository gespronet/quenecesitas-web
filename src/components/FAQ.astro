---
export interface Props {
  title?: string;
  items: { question: string; answer: string }[];
}

const { title = "Preguntas frecuentes", items } = Astro.props;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};
---

<section class="qn-faq" aria-labelledby="faq-heading">
  <div class="qn-container qn-faq-inner">
    <div>
      <p class="qn-eyebrow">Resolvemos dudas</p>
      <h2 id="faq-heading" class="qn-display-lg qn-faq-title">{title}</h2>
    </div>

    <div class="qn-faq-list">
      {items.map((item) => (
        <details class="qn-faq-item">
          <summary>
            <span>{item.question}</span>
            <span class="qn-faq-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </span>
          </summary>
          <div class="qn-faq-answer">
            <p>{item.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>

<style>
  .qn-faq {
    padding-block: clamp(4rem, 7vw, 6rem);
  }

  .qn-faq-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  .qn-faq-title {
    margin: 1rem 0 0;
  }

  .qn-faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .qn-faq-item {
    border: 1px solid var(--color-fog);
    border-radius: var(--radius-lg);
    background: white;
    overflow: hidden;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .qn-faq-item[open] {
    border-color: var(--color-brand-200);
    box-shadow: var(--shadow-soft);
  }

  .qn-faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.125rem 1.25rem;
    cursor: pointer;
    font-weight: 500;
    color: var(--color-brand-600);
    font-size: 1rem;
    list-style: none;
  }

  .qn-faq-item summary::-webkit-details-marker {
    display: none;
  }

  .qn-faq-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--color-brand-100);
    color: var(--color-brand-600);
    transition: transform 0.25s ease, background 0.25s ease;
    flex-shrink: 0;
  }

  .qn-faq-item[open] .qn-faq-icon {
    background: var(--color-accent-500);
    color: white;
    transform: rotate(45deg);
  }

  .qn-faq-answer {
    padding: 0 1.25rem 1.25rem;
  }

  .qn-faq-answer p {
    margin: 0;
    color: var(--color-graphite);
    font-size: 0.9375rem;
    line-height: 1.65;
  }

  @media (min-width: 900px) {
    .qn-faq-inner {
      grid-template-columns: 1fr 1.6fr;
      gap: 4rem;
    }
  }
</style>
