---
const stats = [
  { number: "4 sectores", label: "Una sola conversación" },
  { number: "0 €", label: "Asesoramiento sin coste" },
  { number: "100%", label: "Multimarca, sin atarte" },
  { number: "Galicia", label: "Equipo comercial local" },
];
---

<section class="qn-stats" aria-label="Datos clave de queNECESITAS">
  <div class="qn-container qn-stats-inner">
    {stats.map((stat, i) => (
      <div class={`qn-stat qn-reveal qn-reveal-delay-${(i % 5) + 1}`}>
        <p class="qn-stat-num">{stat.number}</p>
        <p class="qn-stat-lbl">{stat.label}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .qn-stats {
    background: var(--color-brand-100);
    padding-block: 1.75rem;
    border-block: 1px solid rgba(0, 34, 146, 0.08);
  }

  .qn-stats-inner {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem 2rem;
  }

  .qn-stat-num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.375rem, 2vw, 1.75rem);
    color: var(--color-brand-600);
    letter-spacing: -0.025em;
    line-height: 1;
    margin: 0 0 0.375rem;
  }

  .qn-stat-lbl {
    font-size: 0.8125rem;
    color: var(--color-graphite);
    margin: 0;
    line-height: 1.4;
  }

  @media (min-width: 640px) {
    .qn-stats-inner {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
