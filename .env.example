# URL del webhook de n8n al que se envían los formularios
# Importante: prefijo PUBLIC_ porque se accede desde el cliente
PUBLIC_N8N_WEBHOOK_URL=https://n8n.tu-dominio.com/webhook/quenecesitas-leads

# URL canónica del sitio (sin barra final)
PUBLIC_SITE_URL=https://quenecesitashoy.es

# Supabase — sección de inmuebles (src/lib/properties.js)
# La anon key es pública por diseño (protegida por RLS en Supabase), por eso
# lleva prefijo PUBLIC_ como el resto de variables de este proyecto.
PUBLIC_SUPABASE_URL=https://vkhbkdibihwmwyshrofx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=

# Bucket de Supabase Storage donde viven las fotos referenciadas en
# property_photos.url. Ajusta si el bucket real se llama distinto.
PUBLIC_SUPABASE_PHOTOS_BUCKET=documentos
