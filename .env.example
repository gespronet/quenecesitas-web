# queNECESITAS · Variables de entorno
# Copia este archivo como .env y rellena con tus valores reales
# NO subir .env a git (ya está en .gitignore)

# URL del webhook de n8n para captura de leads
# En dev puedes usar la URL de test para probar
PUBLIC_N8N_WEBHOOK_URL=https://n8n.gespronet.cloud/webhook/quenecesitas-leads

# URL pública del sitio
PUBLIC_SITE_URL=https://quenecesitashoy.es
