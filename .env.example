# =========================================================
# Variables de entorno · queNECESITAS web
# =========================================================
# Copia este archivo como .env (no se sube a git) y rellena.
# Para producción añade las mismas variables a GitHub Secrets.
# =========================================================

# Supabase · CRM queNECESITAS (proyecto "Que Necesitas CRM")
# https://app.supabase.com/project/vkhbkdibihwmwyshrofx
PUBLIC_SUPABASE_URL=https://vkhbkdibihwmwyshrofx.supabase.co

# Service role key — SOLO se usa en build time para firmar URLs de fotos.
# Nunca se expone en el cliente. Astro solo la usa en el server.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_....

# Webhook n8n para leads de la web
PUBLIC_N8N_LEAD_WEBHOOK=https://n8n.gespronet.cloud/webhook/quenecesitas-leads
