# =========================================================
# queNECESITAS · .htaccess para Hostinger (Apache/LiteSpeed)
# Sitio estático generado con Astro 5
# =========================================================

# Activar motor de reescritura
RewriteEngine On

# ---------------------------------------------------------
# 1. Forzar HTTPS
# ---------------------------------------------------------
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ---------------------------------------------------------
# 2. Redirigir www a apex (quenecesitashoy.es)
# ---------------------------------------------------------
RewriteCond %{HTTP_HOST} ^www\.quenecesitashoy\.es$ [NC]
RewriteRule ^ https://quenecesitashoy.es%{REQUEST_URI} [L,R=301]

# ---------------------------------------------------------
# 3. URLs limpias: /nosotros -> /nosotros/index.html
# ---------------------------------------------------------
# Si el path pedido no existe como archivo pero SÍ existe como
# carpeta con un index.html, servir ese index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*)$ $1/index.html [L]

# También aceptar /nosotros.html si en algún caso Astro genera así
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# ---------------------------------------------------------
# 4. Página 404 personalizada
# ---------------------------------------------------------
ErrorDocument 404 /404.html

# ---------------------------------------------------------
# 5. Compresión GZIP
# ---------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/ttf font/otf font/woff font/woff2
</IfModule>

# ---------------------------------------------------------
# 6. Cache-Control para assets
# ---------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML: sin cache larga (para que se vean cambios al desplegar)
  ExpiresByType text/html "access plus 1 hour"

  # CSS y JS con hash de Astro: cache larga
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"

  # Imágenes
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"

  # Fuentes
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"

  # XML/JSON (sitemap y datos)
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType text/xml "access plus 1 day"
  ExpiresByType application/json "access plus 1 hour"
</IfModule>

# ---------------------------------------------------------
# 7. Headers de seguridad
# ---------------------------------------------------------
<IfModule mod_headers.c>
  # Protección XSS
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # HSTS (comentado por si acaso, actívalo cuando estés seguro)
  # Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Permissions Policy
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# ---------------------------------------------------------
# 8. Bloquear acceso a archivos sensibles
# ---------------------------------------------------------
<FilesMatch "^\.(env|git|htaccess|htpasswd)">
  Require all denied
</FilesMatch>

# ---------------------------------------------------------
# 9. MIME types que Hostinger a veces se salta
# ---------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/font-woff2 .woff2
  AddType image/svg+xml .svg
  AddType application/manifest+json .webmanifest
</IfModule>
